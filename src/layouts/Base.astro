---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteBackground from '../components/SiteBackground.astro';
import { getProfile } from '../lib/content';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL hoặc path bắt đầu bằng / cho og:image (mặc định: hero-astronaut.webp). */
  image?: string;
  /** JSON-LD bổ sung cho từng trang (vd BlogPosting). Person + WebSite luôn được nhúng sẵn. */
  schema?: Record<string, any> | Record<string, any>[];
  /** og:type override — mặc định "website", blog dùng "article". */
  ogType?: 'website' | 'article';
  /** Article meta (og:article:*) — chỉ dùng khi ogType = "article". */
  articleMeta?: { publishedTime?: string; tags?: string[] };
  /** Nền động global (constellation). Tắt ở trang có nền riêng (vd /journey starfield). */
  animatedBg?: boolean;
  /** Thêm <meta name="robots" content="noindex"> — dùng cho trang locale chưa có bản dịch thật. */
  noindex?: boolean;
  /** Locale có nội dung thật. Nếu set, chỉ emit hreflang cho các locale này. Mặc định: all. */
  availableLocales?: Lang[];
}
const { title, description, image, schema, ogType = 'website', articleMeta, animatedBg = true, noindex = false, availableLocales } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfile(lang);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const basePath = path.replace(/^\/(vi|ja)(?=\/|$)/, '') || '/'; // strip lang prefix → logical path
const fullTitle = title ? `${title} · ${profile.identity.nameEn}` : `${profile.identity.nameEn} · ${profile.identity.title}`;
const desc = description ?? profile.summary;
const site = Astro.site ?? new URL('https://doxuanloc.space');
const canonical = new URL(path, site).href;
const ogImage = image
  ? (image.startsWith('http') ? image : new URL(image, site).href)
  : new URL('/images/hero-astronaut.webp', site).href;
const altEn = new URL(basePath, site).href;
const altVi = new URL('/vi' + (basePath === '/' ? '' : basePath), site).href;
const altJa = new URL('/ja' + (basePath === '/' ? '' : basePath), site).href;
const langLinks = [
  { code: 'en', label: 'EN', href: basePath },
  { code: 'vi', label: 'VI', href: '/vi' + (basePath === '/' ? '' : basePath) },
  { code: 'ja', label: 'JA', href: '/ja' + (basePath === '/' ? '' : basePath) },
] as const;

const id = profile.identity;
const sameAs = [id.links?.linkedin, id.links?.github, id.links?.currentPortfolio].filter(Boolean);
const ogLocale = lang === 'vi' ? 'vi_VN' : lang === 'ja' ? 'ja_JP' : 'en_US';
// og:locale:alternate — emit alternate locales (excluding current)
const ogLocaleMap: Record<string, string> = { en: 'en_US', vi: 'vi_VN', ja: 'ja_JP' };
const ogLocaleAlternates = (availableLocales ?? ['en', 'vi'])
  .filter(l => l !== lang)
  .map(l => ogLocaleMap[l])
  .filter(Boolean);
const siteOrigin = (Astro.site ?? new URL('https://doxuanloc.space')).toString().replace(/\/$/, '');
const avatarUrl = `${siteOrigin}/favicon-512.png`;
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: id.name,
  alternateName: id.nameEn,
  jobTitle: id.title,
  description: profile.summary,
  email: `mailto:${id.email}`,
  url: `${siteOrigin}/`,
  image: avatarUrl,
  address: { '@type': 'PostalAddress', addressLocality: id.location },
  knowsLanguage: (profile.languages ?? []).map((l: any) => l.name),
  knowsAbout: Object.values(profile.skills ?? {}).flat(),
  worksFor: { '@type': 'Organization', name: profile.experience?.[0]?.company },
  sameAs,
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: id.nameEn,
  url: `${siteOrigin}/`,
};
const jsonLdBlocks = [personLd, websiteLd, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];

const nav = [
  { p: '/', label: t('nav.home') },
  { p: '/journey', label: t('nav.journey') },
  { p: '/experience', label: t('nav.experience') },
  { p: '/blog', label: t('nav.blog') },
  { p: '/news', label: t('nav.news') },
  { p: '/about', label: t('nav.about') },
].map((n) => ({ href: localizedPath(n.p, lang), label: n.label, logical: n.p }));
function current(logical: string) {
  if (logical === '/') return basePath === '/';
  return basePath === logical || basePath.startsWith(logical + '/');
}
const glyphs: Record<string, string> = {
  '/': '⌂', '/journey': '◎', '/experience': '✴', '/blog': '◈', '/news': '✦', '/about': '◉',
};
function glyphFor(p: string) { return glyphs[p] ?? '·'; }
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={profile.identity.nameEn} />
    <meta name="theme-color" content="#0b0907" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {basePath === '/' && (
      <link rel="preload" as="image" href="/images/hero-astronaut.webp" fetchpriority="high" />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Tektur:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="canonical" href={canonical} />
    {(!availableLocales || availableLocales.includes('en')) && <link rel="alternate" hreflang="en" href={altEn} />}
    {(!availableLocales || availableLocales.includes('vi')) && <link rel="alternate" hreflang="vi" href={altVi} />}
    {(!availableLocales || availableLocales.includes('ja')) && <link rel="alternate" hreflang="ja" href={altJa} />}
    <link rel="alternate" hreflang="x-default" href={availableLocales?.includes('vi') && !availableLocales?.includes('en') ? altVi : altEn} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && articleMeta?.publishedTime && (
      <meta property="article:published_time" content={articleMeta.publishedTime} />
    )}
    {ogType === 'article' && (articleMeta?.tags ?? []).map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={profile.identity.nameEn} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map(l => <meta property="og:locale:alternate" content={l} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    {id.links?.twitter && <meta name="twitter:creator" content={`@${id.links.twitter.replace(/.*\//, '')}`} />}
    <link rel="alternate" type="application/rss+xml" title={`${profile.identity.nameEn} — Blog & Tech radar`} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <ClientRouter />
    <script is:inline>
      (function(){
        function doy(){var n=new Date(),s=new Date(Date.UTC(n.getUTCFullYear(),0,0));return Math.floor((n-s)/864e5);}
        var p=new URLSearchParams(location.search).get('palette');
        document.documentElement.dataset.palette=p!=null?String(parseInt(p,10)%5):String(doy()%5);
      })();
    </script>
  </head>
  <body>
    <div class="space-bg" aria-hidden="true">
      <span class="milky"></span>
      <span class="planet"></span>
      <span class="flare" style="top:16%;left:78%"></span>
      <span class="flare" style="top:62%;left:14%"></span>
      <span class="flare" style="top:38%;left:46%"></span>
      <span class="flare" style="top:80%;left:70%"></span>
      <span class="shoot"></span>
      <span class="shoot s2"></span>
    </div>
    {animatedBg && <SiteBackground />}
    <div class="noise" aria-hidden="true"></div>
    <a href="#main" class="skip-link">{t('skip')}</a>
    <header class="site-header">
      <div class="header-blur" aria-hidden="true"></div>
      <span class="header-scanline" aria-hidden="true"></span>
      <div class="container nav">
        <a class="brand" href={localizedPath('/', lang)}>
          <img src="/images/logo.png" alt="" class="brand-logo" width="28" height="28" aria-hidden="true" />
          {profile.identity.nameEn}<span class="brand-dot">.</span>
        </a>
        <div class="nav-right">
          <nav id="main-nav" aria-label="Main">
            <div class="drawer-header" aria-hidden="true">
              <span class="drawer-title">MENU</span>
            </div>
            <ul>
              {nav.map((n) => (
                <li><a href={n.href} aria-current={current(n.logical) ? 'page' : undefined} data-glyph={glyphFor(n.logical)}>{n.label}</a></li>
              ))}
            </ul>
            <div class="drawer-footer" aria-hidden="true">
              <div class="lang-switch-3">
                {langLinks.map((l) => (
                  <a href={l.href} class:list={['ls3-item', l.code === lang ? 'on' : '']} data-astro-reload>{l.label}</a>
                ))}
              </div>
              <span class="drawer-site mono">doxuanloc.space</span>
            </div>
            <span class="drawer-lines" aria-hidden="true"><span></span><span></span></span>
            <span class="drawer-bracket tl" aria-hidden="true"></span>
            <span class="drawer-bracket tr" aria-hidden="true"></span>
            <span class="drawer-bracket bl" aria-hidden="true"></span>
            <span class="drawer-bracket br" aria-hidden="true"></span>
          </nav>
          <div class="lang-switch-3" aria-label="Language">
            {langLinks.map((l) => (
              <a href={l.href} class:list={['ls3-item', l.code === lang ? 'on' : '']} data-astro-reload>{l.label}</a>
            ))}
          </div>
          <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav" type="button">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>
    <div id="nav-overlay" aria-hidden="true"></div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <div style="font-weight:600;color:var(--text)">{profile.identity.nameEn}<span style="color:var(--accent)">.</span></div>
          <div class="muted" style="margin-top:4px">{profile.identity.title}</div>
          <div class="mono" style="margin-top:10px;font-size:.78rem;color:var(--text-mute)">
            {t('footer.tagline')}
          </div>
        </div>
        <nav aria-label="Footer">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <div class="social">
          {id.links?.linkedin && (
            <a href={id.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z"/></svg>
            </a>
          )}
          {id.links?.github && (
            <a href={id.links.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/></svg>
            </a>
          )}
          <a href={`mailto:${id.email}`} aria-label="Email" title="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </a>
        </div>
      </div>
      <div class="container" style="margin-top:24px;font-size:.82rem;color:var(--text-mute)">
        © {new Date().getFullYear()} {profile.identity.nameEn}. {t('footer.built')}
      </div>
    </footer>

    <script>
      // Scroll-reveal: IntersectionObserver toggles .in (1 lần / phần tử).
      function setupReveal() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.in)');
        if (reduce) { els.forEach((e) => e.classList.add('in')); return; }
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
        els.forEach((e) => io.observe(e));
      }
      // Reading progress (chỉ chạy nếu trang có thanh #read-progress).
      function updateProgress() {
        const bar = document.getElementById('read-progress');
        if (!bar) return;
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      // Parallax sao theo chuột (desktop, không reduced-motion) — đặt --par-x/--par-y.
      const fine = window.matchMedia('(pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (fine) {
        let ptick = false;
        window.addEventListener('mousemove', (e) => {
          if (ptick) return; ptick = true;
          requestAnimationFrame(() => {
            const x = (e.clientX / window.innerWidth - 0.5) * -2;
            const y = (e.clientY / window.innerHeight - 0.5) * -2;
            const r = document.documentElement.style;
            r.setProperty('--par-x', x.toFixed(3));
            r.setProperty('--par-y', y.toFixed(3));
            ptick = false;
          });
        }, { passive: true });
      }

      // Tilt 3D nhẹ cho [data-tilt] (magnetic) — RAF-throttled per element.
      function setupTilt() {
        if (!fine) return;
        document.querySelectorAll<HTMLElement>('[data-tilt]:not([data-tilt-on])').forEach((el) => {
          el.setAttribute('data-tilt-on', '');
          let rect: DOMRect | null = null;
          let ptick = false;
          let lastE: MouseEvent | null = null;
          el.addEventListener('mouseenter', () => { rect = el.getBoundingClientRect(); });
          el.addEventListener('mousemove', (e) => {
            lastE = e;
            if (ptick) return; ptick = true;
            requestAnimationFrame(() => {
              if (!lastE) { ptick = false; return; }
              const r = rect ?? el.getBoundingClientRect();
              const rx = (((lastE.clientY - r.top) / r.height) - 0.5) * -7;
              const ry = (((lastE.clientX - r.left) / r.width) - 0.5) * 7;
              el.style.transform = `perspective(900px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translateY(-4px)`;
              ptick = false;
            });
          });
          el.addEventListener('mouseleave', () => { el.style.transform = ''; rect = null; });
        });
      }

      // Drawer nav (mobile) — slides from right with overlay + ESC + scroll lock.
      function setupNav() {
        const toggle  = document.querySelector<HTMLButtonElement>('.nav-toggle');
        const nav     = document.getElementById('main-nav');
        const overlay = document.getElementById('nav-overlay');
        if (!toggle || !nav) return;

        function openNav() {
          nav.classList.add('open');
          overlay?.classList.add('open');
          toggle.setAttribute('aria-expanded', 'true');
          toggle.setAttribute('aria-label', 'Close menu');
          document.body.style.overflow = 'hidden';
        }
        function closeNav() {
          nav.classList.remove('open');
          overlay?.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open menu');
          document.body.style.overflow = '';
        }

        toggle.addEventListener('click', () => nav.classList.contains('open') ? closeNav() : openNav());
        overlay?.addEventListener('click', closeNav);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeNav(); });
        nav.querySelectorAll('a').forEach(a => a.addEventListener('click', closeNav));
      }

      // astro:page-load chạy cả lần đầu + sau mỗi View Transition.
      document.addEventListener('astro:page-load', () => { setupReveal(); updateProgress(); setupTilt(); setupNav(); });
    </script>
  </body>
</html>
