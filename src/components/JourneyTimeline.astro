---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getProfile } from '../lib/content';
import { getLangFromUrl } from '../i18n/ui';

const milestones = (getProfile(getLangFromUrl(Astro.url)).journey ?? []) as any[];

// Build-time: tìm ảnh trong public/ (thử nhiều đuôi). Không có -> null -> hiện gradient.
function resolvePublic(p?: string): string | null {
  if (!p) return null;
  if (existsSync(join(process.cwd(), 'public', p.replace(/^\//, '')))) return p;
  return null;
}
function resolveJourneyImg(id: string): string | null {
  for (const ext of ['webp', 'jpg', 'jpeg', 'png', 'avif']) {
    const rel = `/images/journey/${id}.${ext}`;
    if (existsSync(join(process.cwd(), 'public', rel.slice(1)))) return rel;
  }
  return null;
}

const kindMeta: Record<string, { c1: string; c2: string; icon: string }> = {
  education: { c1: '#5b8cff', c2: '#36d6c3', icon: '🎓' },
  frontend: { c1: '#36d6c3', c2: '#5b8cff', icon: '🎨' },
  fullstack: { c1: '#b58cff', c2: '#5b8cff', icon: '🧩' },
  blockchain: { c1: '#f0b232', c2: '#b58cff', icon: '⛓️' },
  ai: { c1: '#b58cff', c2: '#36d6c3', icon: '🧠' },
  future: { c1: '#5b8cff', c2: '#b58cff', icon: '🚀' },
};

const items = milestones.map((m, i) => {
  const meta = kindMeta[m.kind] ?? kindMeta.fullstack;
  return {
    ...m,
    meta,
    num: String(i + 1).padStart(2, '0'),
    photo: resolvePublic(m.photo),
    img: resolveJourneyImg(m.id),
  };
});
const n = items.length;
---
<section class="journey" style={`--n:${n}`} data-journey aria-label="Hành trình sự nghiệp">
  <div class="journey-sticky">
    <!-- Rail định vị -->
    <aside class="journey-rail" aria-hidden="true">
      <div class="rail-line"><span class="rail-fill" data-rail-fill></span></div>
      <ol>
        {items.map((m, i) => (
          <li>
            <button class="rail-item" data-go={i} type="button">
              <span class="rail-dot" style={`--c:${m.meta.c1}`}></span>
              <span class="rail-text">
                <span class="rail-year">{m.year}</span>
                <span class="rail-title">{m.title}</span>
              </span>
            </button>
          </li>
        ))}
      </ol>
    </aside>

    <!-- Sân khấu: các panel chồng nhau, crossfade theo scroll -->
    <div class="journey-stage">
      {items.map((m, i) => (
        <article class={`panel kind-${m.kind}${i === 0 ? ' is-active' : ''}`} data-panel={i} style={`--c1:${m.meta.c1};--c2:${m.meta.c2}`}>
          <div class="panel-text">
            {m.codename && <span class="panel-code mono">{m.codename}</span>}
            <span class="panel-num mono">{m.num} / {String(n).padStart(2, '0')}</span>
            <span class="panel-year">{m.year}</span>
            <h2 class="panel-title">{m.title}</h2>
            <p class="panel-narr">{m.narrative}</p>
            <ul class="panel-bullets">
              {(m.bullets ?? []).map((b: string) => <li>{b}</li>)}
            </ul>
            <div class="chips">{(m.tags ?? []).map((t: string) => <span class="chip">{t}</span>)}</div>
          </div>

          <div class="panel-visual" style={`--c1:${m.meta.c1}`}>
            <span class="hud-bracket tl"></span><span class="hud-bracket br"></span>
            {m.photo ? (
              <img src={m.photo} alt={m.photoAlt ?? m.title} loading="lazy" decoding="async" width="640" height="640" />
            ) : m.img ? (
              <img src={m.img} alt={m.imageConcept ?? m.title} loading="lazy" decoding="async" width="800" height="600" />
            ) : (
              <div class="visual-gen" role="img" aria-label={m.imageConcept ?? m.title}>
                <span class="gen-orb"></span>
                <span class="gen-grid"></span>
                <span class="gen-icon">{m.meta.icon}</span>
                <span class="gen-num mono">{m.num}</span>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .journey { position: relative; }
  .journey-sticky { display: block; }
  .journey-rail { display: none; }

  /* ===== Mobile / reduced-motion: timeline dọc thường (không pin) ===== */
  .journey-stage { display: grid; gap: 18px; }
  .panel {
    position: relative;
    display: grid; gap: 20px;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: rgba(18, 27, 53, 0.55);
    padding: 24px; overflow: hidden;
  }
  .panel::before {
    content: ""; position: absolute; inset: 0 auto 0 0; width: 3px;
    background: linear-gradient(var(--c1), var(--c2));
  }
  .panel-num { color: var(--text-mute); font-size: 0.78rem; letter-spacing: 1px; }
  .panel-year { display: inline-block; margin-left: 10px; color: var(--c1); font-family: var(--mono); font-size: 0.82rem; }
  .panel-title { font-size: clamp(1.5rem, 4vw, 2.1rem); letter-spacing: -0.03em; margin: 10px 0 8px; line-height: 1.1; }
  .panel-narr { color: #d4dbee; font-size: 1.05rem; margin: 0 0 14px; max-width: 46ch; }
  .panel-bullets { margin: 0 0 16px; padding-left: 18px; display: grid; gap: 6px; color: var(--text-dim); }
  .panel-bullets li::marker { color: var(--c1); }

  .panel-visual { position: relative; border-radius: 12px; overflow: hidden; min-height: 220px; }
  .panel-visual img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* HUD */
  .panel-code { display: block; color: var(--c1); font-size: 0.72rem; font-weight: 500; letter-spacing: 2.5px; text-transform: uppercase; margin-bottom: 10px; opacity: 0.9; }
  .hud-bracket { position: absolute; width: 24px; height: 24px; z-index: 2; pointer-events: none; opacity: 0.85; }
  .hud-bracket.tl { top: 10px; left: 10px; border-top: 2px solid var(--c1); border-left: 2px solid var(--c1); }
  .hud-bracket.br { bottom: 10px; right: 10px; border-bottom: 2px solid var(--c1); border-right: 2px solid var(--c1); }
  .visual-gen {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 80% 15%, color-mix(in srgb, var(--c1) 45%, transparent), transparent 60%),
      radial-gradient(110% 90% at 15% 90%, color-mix(in srgb, var(--c2) 40%, transparent), transparent 60%),
      #0c1226;
    overflow: hidden;
  }
  .gen-grid {
    position: absolute; inset: 0; opacity: 0.5;
    background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: radial-gradient(120% 100% at 50% 0%, #000, transparent 75%);
  }
  .gen-orb {
    position: absolute; width: 46%; aspect-ratio: 1; right: 8%; top: 14%;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--c1) 80%, white), var(--c2) 70%);
    filter: blur(2px); box-shadow: 0 0 60px color-mix(in srgb, var(--c1) 50%, transparent);
    animation: float 7s var(--ease) infinite;
  }
  @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
  .gen-icon { position: absolute; left: 22px; bottom: 18px; font-size: 2rem; }
  .gen-num { position: absolute; right: 18px; bottom: 10px; font-size: 3.4rem; font-weight: 700; color: rgba(255,255,255,.1); }

  /* ===== Desktop: PIN + crossfade ===== */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .journey { height: calc(var(--n) * 92vh); }
    .journey-sticky {
      position: sticky; top: 0; height: 100vh;
      display: grid; grid-template-columns: 240px 1fr; align-items: center; gap: clamp(40px, 6vw, 110px);
      width: 100%; margin: 0; padding: 0 clamp(32px, 6vw, 96px);
    }
    .journey-rail { display: block; position: relative; align-self: center; }
    .rail-line { position: absolute; left: 5px; top: 6px; bottom: 6px; width: 2px; background: var(--border); border-radius: 2px; }
    .rail-fill { position: absolute; left: 0; top: 0; width: 100%; height: 0; background: linear-gradient(var(--accent), var(--accent-2)); border-radius: 2px; transition: height 0.15s linear; }
    .journey-rail ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
    .rail-item { display: flex; align-items: center; gap: 12px; background: none; border: none; cursor: pointer; padding: 2px 0; text-align: left; width: 100%; }
    .rail-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--bg-card); border: 2px solid var(--border); flex: 0 0 auto; transition: all 0.25s var(--ease); z-index: 1; }
    .rail-text { display: grid; opacity: 0.5; transition: opacity 0.25s var(--ease); }
    .rail-year { font-family: var(--mono); font-size: 0.72rem; color: var(--text-mute); }
    .rail-title { font-size: 0.86rem; color: var(--text-dim); }
    .rail-item.is-active .rail-dot { background: var(--c); border-color: var(--c); box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 25%, transparent); transform: scale(1.15); }
    .rail-item.is-active .rail-text { opacity: 1; }
    .rail-item.is-active .rail-title { color: var(--text); font-weight: 600; }

    .journey-stage { display: block; position: relative; height: 78vh; }
    .panel {
      position: absolute; inset: 0;
      grid-template-columns: 1fr 1fr; align-items: center; gap: 40px;
      padding: 0; background: none; border: none;
      opacity: 0; transform: translateY(26px) scale(0.985); pointer-events: none;
      transition: opacity 0.55s var(--ease-rev), transform 0.55s var(--ease-rev);
    }
    .panel::before { display: none; }
    .panel.is-active { opacity: 1; transform: none; pointer-events: auto; }
    .panel-visual { min-height: 60vh; max-height: 70vh; border: 1px solid var(--border); box-shadow: var(--shadow-lg); transition: border-color 0.5s var(--ease), box-shadow 0.5s var(--ease); }
    .panel.is-active .panel-visual { border-color: color-mix(in srgb, var(--c1) 55%, var(--border)); box-shadow: 0 0 44px color-mix(in srgb, var(--c1) 22%, transparent), var(--shadow-lg); }
    .panel-title { font-size: clamp(2rem, 3.4vw, 2.8rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gen-orb { animation: none; }
  }
</style>

<script>
  function setupJourney() {
    const root = document.querySelector<HTMLElement>('[data-journey]');
    if (!root) return;
    const desktop = window.matchMedia('(min-width: 900px)').matches;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.panel'));
    const rails = Array.from(root.querySelectorAll<HTMLElement>('.rail-item'));
    const fill = root.querySelector<HTMLElement>('[data-rail-fill]');
    const n = panels.length;
    if (!n) return;

    if (!desktop || reduce) {
      panels.forEach((p) => p.classList.add('is-active')); // tất cả hiện (timeline thường)
      return;
    }

    let active = -1, ticking = false;
    function setActive(i: number, p: number) {
      if (fill) fill.style.height = Math.max(0, Math.min(1, p)) * 100 + '%';
      if (i === active) return;
      active = i;
      panels.forEach((el, k) => el.classList.toggle('is-active', k === i));
      rails.forEach((el, k) => el.classList.toggle('is-active', k === i));
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const rect = root.getBoundingClientRect();
        const total = root.offsetHeight - window.innerHeight;
        const scrolled = Math.min(Math.max(-rect.top, 0), total);
        const p = total > 0 ? scrolled / total : 0;
        const idx = Math.min(n - 1, Math.floor(p * n));
        setActive(idx, p);
        ticking = false;
      });
    }
    rails.forEach((btn, i) => btn.addEventListener('click', () => {
      const total = root.offsetHeight - window.innerHeight;
      const y = root.offsetTop + ((i + 0.5) / n) * total;
      window.scrollTo({ top: y, behavior: 'smooth' });
    }));
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    onScroll();
  }
  document.addEventListener('astro:page-load', setupJourney);
</script>
