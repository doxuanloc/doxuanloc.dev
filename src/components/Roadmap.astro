---
import { getProfile } from '../lib/content';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const roadmap = getProfile(lang).roadmap ?? [];
const statusLabel: Record<string, string> = { done: t('status.done'), 'in-progress': t('status.in-progress'), planned: t('status.planned') };
const statusColor: Record<string, string> = { done: 'var(--accent-2)', 'in-progress': 'var(--accent)', planned: 'var(--accent-3)' };
---
<section>
  <div class="container">
    <p class="eyebrow" data-reveal>{t('roadmap.eyebrow')}</p>
    <h2 class="section-title" data-reveal style="--reveal-delay:60ms">{t('roadmap.title')}</h2>
    <p class="section-sub" data-reveal style="--reveal-delay:100ms">{t('roadmap.sub')}</p>
    <div class="aurora-line" data-reveal style="--reveal-delay:140ms;max-width:120px;margin-bottom:28px"></div>

    <div class="rmap">
      {roadmap.map((r: any, i: number) => (
        <div class={`rmap-item card status-${r.status}`} data-reveal data-tilt style={`--reveal-delay:${i * 80}ms;--c:${statusColor[r.status]}`}>
          <div class="rmap-side">
            <span class={`rmap-dot ${r.status === 'in-progress' ? 'live' : ''}`}></span>
            <span class="rmap-idx mono">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="rmap-body">
            <div class="rmap-head">
              <span class="rmap-phase mono">{r.phase}</span>
              <span class="rmap-status mono">{statusLabel[r.status] ?? r.status}</span>
            </div>
            <strong class="rmap-label">{r.label}</strong>
            {r.story && <p class="rmap-story">{r.story}</p>}
            <div class="chips">{(r.focus ?? []).map((f: string) => <span class="chip">{f}</span>)}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .rmap { display: grid; gap: 16px; }
  .rmap-item { display: grid; grid-template-columns: 64px 1fr; gap: 20px; align-items: start; transform-style: preserve-3d; }
  .rmap-side { display: flex; flex-direction: column; align-items: center; gap: 8px; padding-top: 4px; }
  .rmap-dot {
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--c); box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 18%, transparent), 0 0 14px var(--c);
  }
  .rmap-dot.live { animation: rpulse 2s ease-in-out infinite; }
  @keyframes rpulse {
    0%, 100% { box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 20%, transparent), 0 0 10px var(--c); }
    50% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--c) 6%, transparent), 0 0 22px var(--c); }
  }
  .rmap-idx { font-size: 0.8rem; color: var(--text-mute); }
  .rmap-head { display: flex; align-items: center; gap: 12px; margin-bottom: 4px; flex-wrap: wrap; }
  .rmap-phase { font-size: 0.78rem; color: var(--c); letter-spacing: 1px; }
  .rmap-status { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-mute); border: 1px solid var(--border); padding: 2px 8px; border-radius: 999px; }
  .rmap-label { font-size: 1.25rem; letter-spacing: -0.02em; display: block; margin-bottom: 6px; }
  .status-in-progress .rmap-label {
    background: linear-gradient(100deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;
  }
  .rmap-story { color: #cfd6ea; margin: 0 0 12px; font-size: 1rem; max-width: 60ch; }

  /* Responsive: Tablet */
  @media (max-width: 768px) {
    .rmap-item { gap: 16px; }
    .rmap-label { font-size: 1.15rem; }
    .rmap-story { font-size: 0.95rem; }
  }

  /* Responsive: Mobile */
  @media (max-width: 560px) {
    .rmap-item { grid-template-columns: 1fr; gap: 12px; }
    .rmap-side { flex-direction: row; padding-top: 0; }
    .rmap-label { font-size: 1.1rem; }
    .rmap-story { font-size: 0.92rem; margin: 0 0 10px; }
  }

  /* Responsive: Small phones */
  @media (max-width: 400px) {
    .rmap { gap: 14px; }
    .rmap-item { gap: 10px; }
    .rmap-head { gap: 8px; }
    .rmap-phase { font-size: 0.72rem; }
    .rmap-status { font-size: 0.62rem; padding: 2px 6px; }
    .rmap-label { font-size: 1rem; margin-bottom: 4px; }
    .rmap-story { font-size: 0.88rem; }
    .rmap-dot { width: 12px; height: 12px; }
    .rmap-idx { font-size: 0.75rem; }
  }
</style>
