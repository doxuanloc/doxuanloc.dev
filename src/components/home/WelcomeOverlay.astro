---
import { getProfile } from '../../lib/content';
import { getLangFromUrl } from '../../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const id = getProfile(lang).identity;
---

<div id="welcome-overlay" class="w-overlay" aria-hidden="true" role="presentation">
  <!-- Layer 1: video full-screen -->
  <video class="w-video" src="/videos/hero-welcome.mp4"
    autoplay muted loop playsinline preload="auto" aria-hidden="true">
  </video>

  <!-- Layer 2: vignette + atmosphere -->
  <div class="w-vignette"></div>

  <!-- Layer 3: subtle dot grid -->
  <div class="w-grid"></div>

  <!-- Layer 4: orbital rings (CSS) -->
  <div class="w-rings">
    <div class="w-ring r1"></div>
    <div class="w-ring r2"></div>
    <div class="w-ring r3"></div>
  </div>

  <!-- Layer 5: HUD corner brackets -->
  <div class="w-corner tl"></div>
  <div class="w-corner tr"></div>
  <div class="w-corner bl"></div>
  <div class="w-corner br"></div>

  <!-- Layer 6: horizontal scanline -->
  <div class="w-scanline"></div>

  <!-- Layer 7: center content -->
  <div class="w-content">
    <div class="w-mark">
      <img src="/images/logo.png" alt="" class="w-logo" width="100" height="100" />
      <div class="w-mark-corner tl"></div>
      <div class="w-mark-corner tr"></div>
      <div class="w-mark-corner bl"></div>
      <div class="w-mark-corner br"></div>
    </div>
    <div class="w-name w-chroma" data-text={id.name}>{id.name}</div>
    <div class="w-title mono">{id.title}</div>
    <div class="w-status mono" id="w-status" aria-live="polite">INITIALIZING…</div>
    <div class="w-hint mono">SCROLL · CLICK · ESC TO ENTER</div>
  </div>

  <!-- Particle burst container -->
  <div id="w-burst" class="w-burst" aria-hidden="true"></div>

  <!-- Layer 8: bottom progress bar -->
  <div class="w-progress-wrap">
    <div class="w-progress-fill"></div>
  </div>

  <!-- Skip button -->
  <button class="w-skip mono" type="button" aria-label="Skip intro">SKIP ›</button>
</div>

<style>
  /* ── BASE OVERLAY ───────────────────────── */
  .w-overlay {
    position: fixed; inset: 0; z-index: 9000;
    background: #0b0907;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    /* entrance: already visible, layers animate in */
    opacity: 1;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .w-overlay.w-exit {
    opacity: 0;
    transform: scale(1.03);
    pointer-events: none;
  }
  .w-overlay.w-gone { display: none; }

  /* ── LAYER 1: VIDEO ─────────────────────── */
  .w-video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: wVideoIn 1.2s ease 0.1s forwards;
  }
  @keyframes wVideoIn {
    from { opacity: 0; } to { opacity: 0.55; }
  }

  /* ── LAYER 2: VIGNETTE ──────────────────── */
  /* Scrim center → dark content backdrop + edge fade */
  .w-vignette {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(ellipse 52% 60% at 50% 50%,
        color-mix(in srgb, var(--bg) 62%, transparent) 0%,
        color-mix(in srgb, var(--bg) 26%, transparent) 55%,
        transparent 100%),
      linear-gradient(180deg,
        color-mix(in srgb, var(--bg) 55%, transparent) 0%,
        transparent 18%,
        transparent 78%,
        color-mix(in srgb, var(--bg) 65%, transparent) 100%);
  }

  /* ── LAYER 3: DOT GRID ──────────────────── */
  .w-grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(circle, rgba(224,112,77,0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0;
    animation: wFadeIn 0.8s ease 0.6s forwards;
  }
  /* Hidden on mobile — reduces noise */
  @media (max-width: 700px) { .w-grid { display: none; } }

  /* ── LAYER 4: ORBITAL RINGS ─────────────── */
  .w-rings { position: absolute; inset: 0; pointer-events: none; }
  .w-ring {
    position: absolute;
    left: 50%; top: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    animation: wRingIn 0.7s ease forwards, wRingSpin 28s linear infinite;
  }
  .r1 {
    width: 220px; height: 220px;
    border: 1px solid color-mix(in srgb, var(--accent-2) 40%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent-2) 15%, transparent);
    animation-delay: 0.35s, 0s;
  }
  .r2 {
    width: 420px; height: 420px;
    border: 1px dashed color-mix(in srgb, var(--accent) 30%, transparent);
    animation-delay: 0.5s, 0s;
    animation-direction: normal, reverse;
    animation-duration: 0.7s, 36s;
  }
  .r3 {
    width: 620px; height: 620px;
    border: 1px solid color-mix(in srgb, var(--accent-3) 20%, transparent);
    animation-delay: 0.65s, 0s;
    animation-duration: 0.7s, 52s;
    animation-direction: normal, reverse;
  }
  /* Locking phase: rings pulse */
  .w-overlay.locking .r1 {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent-2) 35%, transparent),
                0 0 18px color-mix(in srgb, var(--accent-2) 25%, transparent);
    transition: box-shadow 0.5s ease;
  }
  .w-overlay.locking .r2 {
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 20%, transparent);
    transition: box-shadow 0.5s ease;
  }
  .w-overlay.locking .r3 {
    border-color: color-mix(in srgb, var(--accent-3) 38%, transparent);
    box-shadow: 0 0 32px color-mix(in srgb, var(--accent) 14%, transparent),
                0 0 90px color-mix(in srgb, var(--accent-2) 7%, transparent);
    transition: box-shadow 0.9s ease, border-color 0.9s ease;
  }
  /* Mobile: only outermost ring as subtle halo */
  @media (max-width: 700px) {
    .r1 { display: none; }
    .r2 { display: none; }
    .r3 { width: 360px; height: 360px; }
  }
  @keyframes wRingIn {
    from { opacity: 0; transform: translate(-50%,-50%) scale(0.85); }
    to   { opacity: 1; transform: translate(-50%,-50%) scale(1); }
  }
  @keyframes wRingSpin {
    to { transform: translate(-50%,-50%) rotate(360deg); }
  }

  /* ── LAYER 5: HUD CORNERS ───────────────── */
  .w-corner {
    position: absolute;
    width: 28px; height: 28px;
    opacity: 0;
    animation: wFadeIn 0.4s ease 0.25s forwards;
  }
  .w-corner.tl { top: 20px; left: 20px; border-top: 2px solid var(--accent, #e0704d); border-left: 2px solid var(--accent, #e0704d); }
  .w-corner.tr { top: 20px; right: 20px; border-top: 2px solid var(--accent, #e0704d); border-right: 2px solid var(--accent, #e0704d); }
  .w-corner.bl { bottom: 36px; left: 20px; border-bottom: 2px solid var(--accent-2, #ebb36b); border-left: 2px solid var(--accent-2, #ebb36b); }
  .w-corner.br { bottom: 36px; right: 20px; border-bottom: 2px solid var(--accent-2, #ebb36b); border-right: 2px solid var(--accent-2, #ebb36b); }
  @media (max-width: 600px) {
    .w-corner { width: 18px; height: 18px; }
    .w-corner.tl, .w-corner.tr { top: 12px; }
    .w-corner.bl, .w-corner.br { bottom: 28px; }
    .w-corner.tl, .w-corner.bl { left: 12px; }
    .w-corner.tr, .w-corner.br { right: 12px; }
  }

  /* ── LAYER 6: SCANLINE ──────────────────── */
  .w-scanline {
    position: absolute; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(235,179,107,0.4) 30%, rgba(224,112,77,0.3) 70%, transparent 100%);
    animation: wScanMove 6s linear infinite;
    top: -1px;
  }
  @keyframes wScanMove {
    0%   { top: -1px; opacity: 0; }
    5%   { opacity: 0.55; }
    95%  { opacity: 0.3; }
    100% { top: 100%; opacity: 0; }
  }
  @media (max-width: 700px) { .w-scanline { opacity: 0.4; } }

  /* ── LAYER 7: CENTER CONTENT ────────────── */
  .w-content {
    position: relative; z-index: 10;
    display: flex; flex-direction: column; align-items: center;
    gap: 12px; text-align: center;
    padding: 0 24px;
  }

  /* Lock mark */
  .w-mark {
    position: relative;
    width: 80px; height: 80px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 8px;
    opacity: 0;
    animation: wMarkIn 0.6s cubic-bezier(0.16,1,0.3,1) 0.7s forwards;
  }
  @keyframes wMarkIn {
    from { opacity: 0; transform: scale(0.6); }
    to   { opacity: 1; transform: scale(1); }
  }
  .w-logo {
    width: 100px; height: 100px;
    object-fit: contain;
    mix-blend-mode: screen;
    filter: drop-shadow(0 0 28px rgba(224,112,77,0.7)) drop-shadow(0 0 56px rgba(235,179,107,0.35));
  }
  @media (max-width: 700px) {
    .w-logo { width: 88px; height: 88px; }
  }
  .w-mark-corner {
    position: absolute;
    width: 12px; height: 12px;
  }
  .w-mark-corner.tl { top: 0; left: 0; border-top: 1.5px solid #e0704d; border-left: 1.5px solid #e0704d; }
  .w-mark-corner.tr { top: 0; right: 0; border-top: 1.5px solid #e0704d; border-right: 1.5px solid #e0704d; }
  .w-mark-corner.bl { bottom: 0; left: 0; border-bottom: 1.5px solid #e0704d; border-left: 1.5px solid #e0704d; }
  .w-mark-corner.br { bottom: 0; right: 0; border-bottom: 1.5px solid #e0704d; border-right: 1.5px solid #e0704d; }

  .w-name {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 700; letter-spacing: -0.035em;
    background: linear-gradient(90deg, #e0704d, #ebb36b);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0;
    animation: wSlideUp 0.6s ease 1.1s forwards;
    text-shadow: none;
  }
  .w-title {
    font-size: clamp(0.72rem, 1.8vw, 0.9rem);
    letter-spacing: 2.5px; text-transform: uppercase;
    color: rgba(255,255,255,0.65);
    opacity: 0;
    animation: wFadeIn 0.5s ease 1.5s forwards;
  }
  .w-hint {
    font-size: 0.62rem; letter-spacing: 2px; text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 55%, transparent);
    margin-top: 6px;
    opacity: 0;
    animation: wFadeIn 0.5s ease 1.9s forwards;
  }

  /* ── STATUS LINE ─────────────────────────────── */
  .w-status {
    font-size: 0.58rem; letter-spacing: 3px; text-transform: uppercase;
    color: color-mix(in srgb, var(--accent-2) 70%, transparent);
    margin-top: 2px;
    opacity: 0;
    animation: wFadeIn 0.4s ease 0.8s forwards;
    min-height: 1em;
  }
  .w-status::after { content: '_'; animation: blink 0.9s step-end infinite; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  /* ── CHROMATIC ABERRATION on name (pure CSS timing) ── */
  .w-chroma { position: relative; }
  .w-chroma::before,
  .w-chroma::after {
    content: attr(data-text);
    position: absolute; left: 0; top: 0; width: 100%;
    pointer-events: none; mix-blend-mode: screen;
    background: none !important;
    -webkit-background-clip: initial !important;
    background-clip: initial !important;
  }
  .w-chroma::before {
    -webkit-text-fill-color: #ff2a6d; color: #ff2a6d;
    animation: chromaBefore 2.2s cubic-bezier(0.23,1,0.32,1) 0.7s both;
  }
  .w-chroma::after {
    -webkit-text-fill-color: #00f0ff; color: #00f0ff;
    animation: chromaAfter 2.2s cubic-bezier(0.23,1,0.32,1) 0.7s both;
  }
  @keyframes chromaBefore {
    0%   { opacity: 0; transform: translate(-1.6px, 0); }
    20%  { opacity: 0.55; transform: translate(-1.2px, 0); }
    65%  { opacity: 0.45; transform: translate(-0.4px, 0); }
    100% { opacity: 0; transform: translate(0, 0); }
  }
  @keyframes chromaAfter {
    0%   { opacity: 0; transform: translate(1.8px, 0); }
    20%  { opacity: 0.55; transform: translate(1.4px, 0); }
    65%  { opacity: 0.45; transform: translate(0.4px, 0); }
    100% { opacity: 0; transform: translate(0, 0); }
  }

  /* ── GLITCH FLASH ────────────────────────────── */
  @keyframes glitch {
    0%   { transform: translate(0); }
    20%  { transform: translate(-2px, 0); clip-path: inset(2px 0 80% 0); }
    40%  { transform: translate(2px, 0); clip-path: inset(60% 0 10% 0); }
    60%  { transform: translate(-1px, 0); clip-path: inset(30% 0 50% 0); }
    80%  { transform: translate(1px, 0); clip-path: inset(80% 0 5% 0); }
    100% { transform: translate(0); clip-path: none; }
  }
  .w-glitch { animation: glitch 120ms steps(1) !important; }

  /* ── PARTICLE BURST ──────────────────────────── */
  .w-burst { position: absolute; inset: 0; pointer-events: none; z-index: 11; }
  .w-burst .p {
    position: absolute;
    left: 50%; top: 50%;
    width: 5px; height: 5px;
    border-radius: 50%;
    pointer-events: none;
    animation: burstOut var(--dur, 700ms) var(--ease-rev) var(--delay, 0ms) both;
  }
  @keyframes burstOut {
    from { transform: translate(-50%,-50%) scale(1); opacity: 1; }
    to   { transform: translate(calc(-50% + var(--dx,0px)), calc(-50% + var(--dy,0px))) scale(var(--s,0.3)); opacity: 0; }
  }

  @keyframes wFadeIn  { from { opacity:0 } to { opacity:1 } }
  @keyframes wSlideUp { from { opacity:0; transform:translateY(12px) } to { opacity:1; transform:none } }

  /* ── LAYER 8: PROGRESS BAR ──────────────── */
  .w-progress-wrap {
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 2px; background: rgba(255,255,255,0.06);
    z-index: 11;
  }
  .w-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #e0704d, #ebb36b);
    width: 0%;
    animation: wProgress var(--w-duration, 3000ms) linear 0.2s forwards;
  }
  @keyframes wProgress {
    from { width: 0% } to { width: 100% }
  }

  /* ── SKIP BUTTON ────────────────────────── */
  .w-skip {
    position: absolute; top: 18px; right: 64px;
    font-size: 0.65rem; letter-spacing: 2px; text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    background: none; border: none; cursor: pointer; z-index: 12;
    transition: color 0.2s;
    padding: 6px 8px;
    opacity: 0;
    animation: wFadeIn 0.4s ease 0.5s forwards;
  }
  .w-skip:hover { color: rgba(255,255,255,0.75); }
  @media (max-width: 600px) {
    .w-skip { right: 14px; top: 12px; }
  }

  /* ── REDUCED MOTION ─────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .w-overlay { display: none !important; }
  }
</style>

<script>
  const DURATION = 3000;
  const MIN_TIME = 2600;

  const PHASES = [
    { t: 800,  text: 'ACQUIRING SIGNAL…' },
    { t: 1600, text: 'LOCKING… 94%',  lock: true },
    { t: 2200, text: 'LINK ESTABLISHED', glitch: true },
  ];

  function spawnBurst(overlay: Element) {
    const burst = overlay.querySelector('#w-burst');
    if (!burst) return;
    const colors = ['var(--accent)', 'var(--accent-2)', 'var(--accent-3)'];
    for (let i = 0; i < 40; i++) {
      const p = document.createElement('span');
      p.className = 'p';
      const angle = (i / 40) * Math.PI * 2;
      const dist = 60 + Math.random() * 140;
      p.style.cssText = [
        `--dx:${Math.cos(angle) * dist}px`,
        `--dy:${Math.sin(angle) * dist}px`,
        `--dur:${600 + Math.random() * 350}ms`,
        `--delay:${Math.random() * 120}ms`,
        `--s:${0.1 + Math.random() * 0.4}`,
        `background:${colors[i % colors.length]}`,
        `width:${3 + Math.random() * 4}px`,
        `height:${3 + Math.random() * 4}px`,
      ].join(';');
      burst.appendChild(p);
    }
    setTimeout(() => { if (burst.parentNode) burst.innerHTML = ''; }, 1100);
  }

  function initOverlay() {
    const overlay = document.getElementById('welcome-overlay');
    if (!overlay) return;

    if (sessionStorage.getItem('welcomed')) {
      overlay.classList.add('w-gone');
      return;
    }
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      overlay.classList.add('w-gone');
      return;
    }

    document.body.style.overflow = 'hidden';

    const wVideo = overlay.querySelector<HTMLVideoElement>('.w-video');
    if (wVideo) wVideo.play().catch(() => {});

    const status = overlay.querySelector<HTMLElement>('#w-status');
    const chroma = overlay.querySelector<HTMLElement>('.w-chroma');

    // Phase sequence
    PHASES.forEach(({ t, text, lock, glitch }) => {
      setTimeout(() => {
        if (status) status.textContent = text;
        if (lock) {
          overlay.classList.add('locking');
          const mark = overlay.querySelector<HTMLElement>('.w-mark');
          if (mark) {
            mark.style.transition = 'transform 0.25s cubic-bezier(0.16,1,0.3,1)';
            mark.style.transform = 'scale(1.07)';
            setTimeout(() => { mark.style.transform = ''; setTimeout(() => { mark.style.transition = ''; }, 260); }, 250);
          }
        }
        if (glitch) {
          if (chroma) {
            chroma.classList.add('w-glitch');
            setTimeout(() => chroma.classList.remove('w-glitch'), 130);
          }
          if (status) {
            status.style.cssText = 'color:var(--accent-2);text-shadow:0 0 14px var(--accent-2);transition:color 0.8s ease,text-shadow 0.8s ease';
            setTimeout(() => { if (status) status.style.cssText = ''; }, 900);
          }
          if (navigator.vibrate) navigator.vibrate(18);
        }
      }, t);
    });

    let canDismiss = false;
    setTimeout(() => { canDismiss = true; }, MIN_TIME);

    function dismiss(force = false) {
      if (!canDismiss && !force) return;
      if (overlay.classList.contains('w-exit') || overlay.classList.contains('w-gone')) return;
      sessionStorage.setItem('welcomed', '1');
      document.body.style.overflow = '';
      spawnBurst(overlay);
      window.dispatchEvent(new CustomEvent('welcome-exit'));
      overlay.classList.add('w-exit');
      setTimeout(() => overlay.classList.add('w-gone'), 450);
    }

    setTimeout(() => dismiss(true), DURATION);
    overlay.addEventListener('click', () => dismiss());
    window.addEventListener('scroll', () => dismiss(), { once: true, passive: true });
    window.addEventListener('keydown', (e) => {
      if (['Escape', 'Enter', ' '].includes(e.key)) dismiss();
    }, { once: true });

    const skip = overlay.querySelector('.w-skip');
    if (skip) skip.addEventListener('click', (e) => { e.stopPropagation(); dismiss(true); });
  }

  document.addEventListener('astro:page-load', initOverlay);
</script>
