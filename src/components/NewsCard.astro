---
interface Props {
  title: string;
  summary: string;
  source: string;
  tags?: string[];
  date?: string;
  importance?: number;
}
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const { title, summary, source, tags = [], date, importance = 1 } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
let host = '';
try { host = new URL(source).hostname.replace(/^www\./, ''); } catch {}
const topTags = tags.slice(0, 3);
---
<article class={`news-row feed-row${importance >= 3 ? ' news-row--featured' : ''}`}>
  <span class={`news-dot${importance >= 3 ? ' news-dot--hot' : ''}`} aria-hidden="true"></span>
  <div class="news-body">
    <h3 class="news-title">
      <a href={source} target="_blank" rel="noopener">{title}</a>
    </h3>
    <p class="news-summary">{summary}</p>
    <div class="meta-row">
      {host && <a href={source} target="_blank" rel="noopener" class="news-src">{host} ↗</a>}
      {host && topTags.length > 0 && <span class="sep">·</span>}
      {topTags.map((tg) => <span class="chip news-chip">{tg}</span>)}
      {importance >= 3 && <><span class="sep">·</span><span class="chip accent news-hot">{t('news.featured')}</span></>}
    </div>
  </div>
</article>

<style>
  .news-row { align-items: flex-start; }

  .news-dot {
    flex-shrink: 0; width: 7px; height: 7px; border-radius: 50%;
    margin-top: 0.4em;
    background: var(--border); border: 1.5px solid rgba(255,255,255,0.12);
    transition: background 0.2s, box-shadow 0.2s;
  }
  .news-dot--hot {
    background: var(--accent-2);
    box-shadow: 0 0 0 0 rgba(54,214,195,0.5);
    animation: newsHotPulse 2.4s ease-in-out infinite;
  }
  @keyframes newsHotPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(54,214,195,0.45); }
    60%       { box-shadow: 0 0 0 5px rgba(54,214,195,0); }
  }
  @media (prefers-reduced-motion: reduce) { .news-dot--hot { animation: none; } }

  .news-body { flex: 1; min-width: 0; }

  .news-title {
    margin: 0 0 4px; font-size: 0.96rem; font-weight: 600; line-height: 1.38;
  }
  .news-title a {
    color: var(--text); text-decoration: none;
    transition: color 0.18s;
  }
  .news-title a:hover { color: var(--accent-2); }

  .news-summary {
    margin: 0; font-size: 0.82rem; color: var(--text-dim); line-height: 1.55;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-chip { font-size: 0.68rem; padding: 1px 7px; }
  .news-hot  { font-size: 0.66rem; }
  .news-src  { font-size: 0.73rem; }

  .news-row--featured .news-title a { color: var(--text); }
  .news-row--featured:hover { background: rgba(54,214,195,0.04); }

  @media (max-width: 600px) {
    .news-title { font-size: 0.92rem; }
    .news-summary { font-size: 0.79rem; }
  }
</style>
