---
interface Props {
  title: string;
  summary: string;
  source: string;
  tags?: string[];
  date?: string;
  importance?: number;
}
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const { title, summary, source, tags = [], date, importance = 1 } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
let host = '';
try { host = new URL(source).hostname.replace(/^www\./, ''); } catch {}
---
<article class="news-card card">
  <div class="news-head">
    {date && <span class="news-date mono muted">{date}</span>}
    {importance >= 3 && <span class="chip accent news-featured">{t('news.featured')}</span>}
  </div>
  <h3 class="news-title">{title}</h3>
  <p class="news-summary muted">{summary}</p>
  <div class="news-foot">
    <div class="chips">{tags.map((t) => <span class="chip">{t}</span>)}</div>
    {host && <a href={source} target="_blank" rel="noopener" class="mono news-source">{host} ↗</a>}
  </div>
</article>

<style>
  .news-card { display: grid; gap: 8px; }
  .news-head { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; }
  .news-date { font-size: 0.78rem; }
  .news-featured { font-size: 0.7rem; }
  .news-title { margin: 0; font-size: 1.08rem; line-height: 1.35; }
  .news-summary { margin: 0; }
  .news-foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
  .news-source { font-size: 0.8rem; }

  /* Tablet */
  @media (max-width: 768px) {
    .news-title { font-size: 1.02rem; }
    .news-date { font-size: 0.75rem; }
  }

  /* Mobile */
  @media (max-width: 600px) {
    .news-card { gap: 6px; }
    .news-title { font-size: 0.98rem; }
    .news-summary { font-size: 0.92rem; }
    .news-source { font-size: 0.76rem; }
    .news-featured { font-size: 0.66rem; }
  }

  /* Small phones */
  @media (max-width: 400px) {
    .news-title { font-size: 0.94rem; }
    .news-summary { font-size: 0.88rem; }
    .news-date { font-size: 0.72rem; }
  }
</style>
