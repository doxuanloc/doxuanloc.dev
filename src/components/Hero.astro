---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getProfile } from '../lib/content';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfile(lang);
const id = profile.identity;
const heroVideo = existsSync(join(process.cwd(), 'public/videos/hero-welcome.mp4')) ? '/videos/hero-welcome.mp4' : null;
const totalSkills = Object.values(profile.skills).flat().length;
const totalDomains = Object.keys(profile.skills ?? {}).filter(k => (profile.skills[k] ?? []).length > 0).length;
const totalProtocols = (profile.languages ?? []).length;

const caps = lang === 'vi' ? [
  { color: '#5b8cff', label: 'Kiến trúc Hệ thống' },
  { color: '#f0b232', label: 'AI Engineering' },
  { color: '#36d6c3', label: 'Cloud & Tối ưu' },
] : [
  { color: '#5b8cff', label: 'System Architecture' },
  { color: '#f0b232', label: 'AI Engineering' },
  { color: '#36d6c3', label: 'Cloud & Optimization' },
];
---

<section class="hero-section">
  {heroVideo && (
    <video
      class="hero-bg-video"
      src={heroVideo}
      autoplay loop muted playsinline
      preload="none"
      aria-hidden="true"
      width="1280" height="720"
    />
  )}
  <div class="hero-gradient" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-body">

      <div class="hero-top" data-reveal style="--reveal-delay:0ms">
        <div class="hero-lockmark" aria-hidden="true">
          <img src="/images/logo.png" alt="" class="lockmark-img" width="40" height="40" />
          <span class="lm-tl"></span>
          <span class="lm-br"></span>
        </div>
        <div class="badge">
          <span class="pulse"></span>
          <span>{id.location}</span>
        </div>
      </div>

      <h1 class="hero-name" data-reveal style="--reveal-delay:80ms">
        <span class="grad">{id.name}</span>
      </h1>

      <div class="hero-rule" data-reveal style="--reveal-delay:148ms" aria-hidden="true">
        <span class="rule-short"></span>
        <span class="rule-label mono">{id.title}</span>
        <span class="rule-long"></span>
      </div>

      <p class="hero-tagline" data-reveal style="--reveal-delay:205ms">
        {id.tagline}
      </p>

      <div class="hero-caps" data-reveal style="--reveal-delay:268ms">
        {caps.map(c => (
          <div class="cap-item" style={`--cc:${c.color}`}>
            <span class="cap-dot"></span>
            <span>{c.label}</span>
          </div>
        ))}
      </div>

      <div class="hero-telemetry mono" data-reveal style="--reveal-delay:314ms">
        <span class="tele-val">{totalDomains}</span><span class="tele-key"> DOMAINS</span>
        <span class="tele-sep"> · </span>
        <span class="tele-val">{totalSkills}</span><span class="tele-key"> NODES</span>
        <span class="tele-sep"> · </span>
        <span class="tele-val">{totalProtocols}</span><span class="tele-key"> PROTOCOLS</span>
      </div>

      <div class="hero-actions" data-reveal style="--reveal-delay:362ms">
        <a class="btn btn-primary" href={localizedPath('/journey', lang)}>{t('hero.cta1')}</a>
        <a class="btn btn-ghost" href={localizedPath('/experience', lang)}>{t('hero.cta2')}</a>
        <div class="social" style="margin-left:4px">
          {id.links?.linkedin && (
            <a href={id.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z"/></svg>
            </a>
          )}
          {id.links?.github && (
            <a href={id.links.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/></svg>
            </a>
          )}
          <a href={`mailto:${id.email}`} aria-label="Email" title="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ── HERO SECTION ─────────────────────────────────── */
  .hero-section {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 96px 0 80px;
  }

  /* True full-bleed ambient background — no overflow hacks needed */
  .hero-bg-video {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.20;
    z-index: 0;
    pointer-events: none;
  }

  /* Atmospheric gradient over video */
  .hero-gradient {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(108deg, rgba(4,6,14,0.97) 0%, rgba(4,6,14,0.88) 48%, rgba(4,6,14,0.38) 100%),
      linear-gradient(180deg, rgba(4,6,14,0.60) 0%, transparent 10%, transparent 84%, rgba(4,6,14,0.95) 100%);
  }

  /* Content sits above gradients */
  .hero-body {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  /* ── TOP ROW: lockmark + status ─────────────────── */
  .hero-top {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
  }

  .hero-lockmark {
    position: relative;
    width: 48px; height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .lockmark-img {
    width: 40px; height: 40px;
    object-fit: contain;
    mix-blend-mode: screen;
    filter: drop-shadow(0 0 8px rgba(91,140,255,0.55));
  }
  .lm-tl, .lm-br { position: absolute; width: 9px; height: 9px; }
  .lm-tl { top: 1px; left: 1px; border-top: 1.5px solid #5b8cff; border-left: 1.5px solid #5b8cff; }
  .lm-br { bottom: 1px; right: 1px; border-bottom: 1.5px solid #36d6c3; border-right: 1.5px solid #36d6c3; }

  /* ── NAME — flagship typography ─────────────────── */
  .hero-name {
    font-size: clamp(3.2rem, 9.5vw, 6.8rem);
    font-weight: 800;
    letter-spacing: -0.048em;
    line-height: 0.95;
    margin: 0 0 20px;
  }

  /* ── TITLE SEPARATOR RULE ───────────────────────── */
  .hero-rule {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 24px;
  }
  .rule-short {
    display: block; height: 1px; width: 32px;
    background: rgba(91,140,255,0.55);
    flex-shrink: 0;
  }
  .rule-label {
    font-size: 0.68rem; letter-spacing: 3px; text-transform: uppercase;
    color: rgba(255,255,255,0.47); white-space: nowrap;
  }
  .rule-long {
    display: block; flex: 1; height: 1px;
    background: linear-gradient(90deg, rgba(91,140,255,0.32), transparent);
  }

  /* ── TAGLINE ────────────────────────────────────── */
  .hero-tagline {
    max-width: 580px;
    color: #cfd6ea;
    font-size: clamp(0.98rem, 1.9vw, 1.12rem);
    line-height: 1.68;
    margin: 0 0 26px;
  }

  /* ── CAPABILITY PILLS ───────────────────────────── */
  .hero-caps {
    display: flex; flex-wrap: wrap; gap: 9px;
    margin: 0 0 22px;
  }
  .cap-item {
    display: flex; align-items: center; gap: 7px;
    padding: 5px 14px 5px 9px;
    border: 1px solid color-mix(in srgb, var(--cc) 28%, transparent);
    border-radius: 20px;
    background: color-mix(in srgb, var(--cc) 6%, transparent);
    font-size: 0.82rem; font-weight: 500;
    color: var(--cc);
  }
  .cap-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--cc);
    box-shadow: 0 0 6px var(--cc);
    flex-shrink: 0;
  }

  /* ── TELEMETRY READOUT ──────────────────────────── */
  .hero-telemetry {
    display: flex; align-items: center; flex-wrap: wrap;
    font-size: 0.67rem; letter-spacing: 1.5px; text-transform: uppercase;
    margin: 0 0 28px;
    padding: 7px 12px;
    border: 1px solid rgba(91,140,255,0.12);
    border-radius: 6px;
    background: rgba(91,140,255,0.03);
    width: fit-content;
  }
  .tele-val { color: var(--accent-2); font-weight: 600; }
  .tele-key { color: var(--text-mute); font-size: 0.62rem; }
  .tele-sep { color: rgba(255,255,255,0.15); }

  /* ── ACTIONS ────────────────────────────────────── */
  .hero-actions {
    display: flex; gap: 12px; flex-wrap: wrap; align-items: center;
  }

  /* ── RESPONSIVE ─────────────────────────────────── */
  @media (max-width: 599px) {
    .hero-section { padding: 72px 0 56px; }
  }
  @media (max-width: 399px) {
    .hero-section { padding: 60px 0 44px; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const v = document.querySelector<HTMLVideoElement>('.hero-bg-video');
    if (v) v.play().catch(() => {});
  });
</script>
