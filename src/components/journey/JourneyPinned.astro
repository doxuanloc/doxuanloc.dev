---
/**
 * JourneyPinned.astro — Pinned scrollytelling, Web3 aesthetic
 * Desktop: sticky 100dvh, panel crossfade on scroll, left timeline rail
 * Mobile: vertical cards
 */
import { getProfile } from '../../lib/content';
import { getLangFromUrl } from '../../i18n/ui';
import { prepareMilestones } from './utils';
import type { MilestoneRaw } from './types';

const lang = getLangFromUrl(Astro.url);
const rawMilestones = (getProfile(lang).journey ?? []) as MilestoneRaw[];
const milestones = prepareMilestones(rawMilestones);
const n = milestones.length;

const chapterMeta: Record<string, { label: string; c: string }> = {
  origins:      { label: 'Origins',      c: '#5b8cff' },
  forge:        { label: 'Forge',        c: '#36d6c3' },
  systems:      { label: 'Systems',      c: '#b58cff' },
  intelligence: { label: 'Intelligence', c: '#f0b232' },
  horizon:      { label: 'Horizon',      c: '#ff7eb3' },
};

// Group milestones by chapter for the rail
type RailGroup = { id: string; label: string; c: string; items: typeof milestones };
const railGroups: RailGroup[] = [];
const seen = new Set<string>();
for (const m of milestones) {
  const ch = (m as any).chapter ?? 'other';
  if (!seen.has(ch)) {
    seen.add(ch);
    railGroups.push({
      id: ch,
      label: chapterMeta[ch]?.label ?? ch,
      c: chapterMeta[ch]?.c ?? '#5b8cff',
      items: [],
    });
  }
  railGroups.find(g => g.id === ch)!.items.push(m);
}
---

<div class="jp-root" style={`--n:${n}`} data-jp>

  <!-- STICKY STAGE -->
  <div class="jp-sticky">

    <!-- Dot-grid background -->
    <div class="jp-bg" aria-hidden="true"></div>

    <!-- ── LEFT RAIL ─────────────────────────── -->
    <aside class="jp-rail" aria-hidden="true">

      <!-- Mission HUD -->
      <div class="jp-hud-top">
        <span class="jp-hud-label">FLIGHT LOG</span>
        <span class="jp-hud-counter mono" data-jp-counter>
          <span data-jp-cur>01</span><span class="jp-hud-sep">/</span>{String(n).padStart(2,'0')}
        </span>
      </div>

      <!-- Rail line + chapter groups -->
      <div class="jp-rail-inner">
        <div class="jp-rail-line">
          <span class="jp-rail-fill" data-jp-fill></span>
        </div>

        {railGroups.map(group => (
          <div class="jp-chapter" style={`--cc:${group.c}`}>
            <div class="jp-chapter-gate">
              <span class="jp-chapter-name">{group.label}</span>
            </div>
            <ol>
              {group.items.map((m: any) => (
                <li>
                  <button class="jp-node" data-go={m.index} type="button" style={`--mc:${m.meta.c1}`}>
                    <span class="jp-node-dot"></span>
                    <span class="jp-node-info">
                      <span class="jp-node-year mono">{m.year}</span>
                      <span class="jp-node-title">{m.title}</span>
                    </span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>

      <!-- Chapter progress bar -->
      <div class="jp-rail-foot">
        <div class="jp-rail-track">
          <span class="jp-rail-prog" data-jp-fill></span>
        </div>
      </div>
    </aside>

    <!-- ── RIGHT STAGE ─────────────────────────── -->
    <div class="jp-stage">
      {milestones.map((m: any, i: number) => (
        <article
          class={`jp-panel${i === 0 ? ' is-active' : ''}`}
          data-panel={i}
          style={`--c1:${m.meta.c1};--c2:${m.meta.c2}`}
        >
          <!-- Glass card -->
          <div class="jp-glass">

            <!-- HUD bar -->
            <div class="jp-panel-hud">
              <span class="jp-panel-code">{m.codename ?? `${(m.kind as string).toUpperCase()}-${m.num}`}</span>
              <span class="jp-panel-sep" aria-hidden="true">·</span>
              <span class="jp-panel-chapter-tag">{chapterMeta[(m as any).chapter]?.label ?? ''}</span>
              <span style="flex:1"></span>
              <span class="jp-panel-frac mono">{m.num}<span class="muted"> / {String(n).padStart(2,'0')}</span></span>
            </div>

            <!-- Body: text | visual -->
            <div class="jp-panel-body">

              <!-- Text column: 3 zones -->
              <div class="jp-panel-text">

                <!-- TOP: year + ghost year + title -->
                <div class="jp-text-top">
                  <time class="jp-year">{m.year}</time>
                  <span class="jp-ghost-year mono" aria-hidden="true">{m.year.replace(/[^0-9]/g, '').slice(0,4)}</span>
                  <h2 class="jp-title">{m.title}</h2>
                </div>

                <!-- MID: narrative (clamped 3 lines) -->
                <div class="jp-text-mid">
                  <p class="jp-narr">{m.narrative}</p>
                </div>

                <!-- BOT: chips → bullets compact -->
                <div class="jp-text-bot">
                  <div class="chips jp-chips">
                    {(m.tags ?? [] as string[]).map((tag: string) => (
                      <span class="chip jp-chip">{tag}</span>
                    ))}
                  </div>
                  {(m.bullets ?? []).length > 0 && (
                    <ul class="jp-bullets">
                      {(m.bullets as string[]).map(b => <li>{b}</li>)}
                    </ul>
                  )}
                </div>

              </div>

              <!-- Visual column -->
              <div class="jp-panel-vis" style={`--c1:${m.meta.c1};--c2:${m.meta.c2}`}>
                <span class="hud-bracket tl"></span>
                <span class="hud-bracket br"></span>

                {m.resolvedPhoto ? (
                  <div class="jp-img-wrap">
                    <img src={m.resolvedPhoto} alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" width="800" height="1000" />
                  </div>
                ) : m.resolvedImage ? (
                  <div class="jp-img-wrap">
                    <img src={m.resolvedImage} alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" width="1280" height="720" />
                  </div>
                ) : (
                  <div class="jp-vis-gen">
                    <span class="vis-grid"></span>
                    <span class="vis-ring r1"></span>
                    <span class="vis-ring r2"></span>
                    <span class="vis-ring r3"></span>
                    <span class="vis-orb"></span>
                    <span class="vis-kind mono">{m.kind}</span>
                    <span class="vis-num mono">{m.num}</span>
                  </div>
                )}

                <!-- overlay gradient -->
                <div class="jp-vis-overlay"></div>
                <!-- scan line -->
                <div class="jp-scan" aria-hidden="true"></div>
              </div>

            </div>
          </div>

          <!-- Active glow ring (outside glass) -->
          <div class="jp-glow-ring" aria-hidden="true"></div>
        </article>
      ))}
    </div>

  </div>
</div>

<!-- Mobile: scroll hint -->
<p class="jp-mobile-hint muted mono" aria-hidden="true">↓ scroll</p>

<style>
  /* ── ROOT & STICKY ───────────────────────── */
  .jp-root {
    position: relative;
    /* scrollytelling height: n panels × 100vh */
  }
  .jp-sticky {
    display: block;
    position: relative;
    background: transparent;
  }

  .jp-bg {
    position: absolute; inset: 0; pointer-events: none; z-index: 0;
    background-image: radial-gradient(rgba(91,140,255,0.07) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 40%, transparent 90%);
  }

  /* ── MOBILE LAYOUT (default) ─────────────── */
  .jp-rail { display: none; }
  .jp-mobile-hint { display: block; text-align: center; font-size: .75rem; letter-spacing: 2px; padding: 24px 0 8px; opacity: 0.4; }

  .jp-stage { display: grid; gap: 20px; padding: 0 0 40px; }

  .jp-panel {
    position: relative;
    border-radius: 16px; overflow: hidden;
  }
  .jp-glass {
    background: rgba(10, 15, 36, 0.7);
    border: 1px solid rgba(255,255,255,0.07);
    border-left: 2px solid var(--c1);
    border-radius: 16px;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
  }
  /* HUD bar */
  .jp-panel-hud {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    background: rgba(0,0,0,0.2);
  }
  .jp-panel-code {
    font-family: var(--mono); font-size: 0.64rem; letter-spacing: 3px;
    text-transform: uppercase; color: var(--c1); opacity: 0.9;
  }
  .jp-panel-sep { color: var(--border); }
  .jp-panel-chapter-tag {
    font-family: var(--display); font-size: 0.62rem; letter-spacing: 2px;
    text-transform: uppercase; color: var(--text-mute);
  }
  .jp-panel-frac { font-size: 0.7rem; color: var(--accent); }
  /* ── PANEL BODY: full-bleed 16:9 ────────── */
  .jp-glass { grid-template-rows: auto auto; }   /* let body size from aspect-ratio */
  /* Mobile: stacked layout — image on top, content below */
  .jp-panel-body {
    position: relative;
    display: flex; flex-direction: column;
    overflow: hidden;
  }
  .jp-panel-text {
    position: relative;
    padding: 16px 16px 20px;
    display: flex; flex-direction: column; justify-content: flex-start;
    gap: 10px; overflow: visible;
    background: none;
  }
  .jp-text-top { position: relative; margin-bottom: 0; }
  .jp-text-mid { margin-bottom: 0; }
  .jp-text-bot { display: flex; flex-direction: column; gap: 8px; }

  /* Ghost year behind title */
  .jp-ghost-year {
    position: absolute; top: -10px; right: -4px;
    font-size: clamp(3.5rem, 8vw, 5.5rem); font-weight: 900; line-height: 1;
    color: var(--c1); opacity: 0.06; pointer-events: none; user-select: none;
    letter-spacing: -0.06em; z-index: 0;
  }
  .jp-year {
    display: block; font-family: var(--mono); font-size: 0.74rem;
    color: var(--c1); letter-spacing: 3px; text-transform: uppercase;
    margin-bottom: 8px; position: relative; z-index: 1;
  }
  .jp-title {
    font-size: clamp(1.4rem, 3.5vw, 2rem); font-weight: 800;
    letter-spacing: -0.03em; line-height: 1.12; margin: 0;
    position: relative; z-index: 1;
  }
  /* Narrative: max 3 lines */
  .jp-narr {
    color: #b8c4de; font-size: 0.93rem; line-height: 1.68; margin: 0;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Chips */
  .jp-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .jp-chip {
    font-size: 0.77rem;
    border-color: color-mix(in srgb, var(--c1) 35%, var(--border));
    color: color-mix(in srgb, var(--c1) 85%, var(--text));
    background: color-mix(in srgb, var(--c1) 6%, transparent);
  }
  /* Bullets: compact arrow list */
  .jp-bullets {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 5px;
  }
  .jp-bullets li {
    font-size: 0.82rem; color: var(--text-mute); line-height: 1.4;
    padding-left: 14px; position: relative;
  }
  .jp-bullets li::before {
    content: "↗"; position: absolute; left: 0;
    color: var(--c1); font-size: 0.7rem; top: 1px;
  }
  /* Visual: absolute, fills panel body */
  .jp-panel-vis {
    order: -1;          /* move image before text in mobile flex column */
    position: relative;
    aspect-ratio: 16/9; min-height: 160px;
    overflow: hidden; flex-shrink: 0;
    background: rgba(0,0,0,0.35);
  }
  /* Bottom fade: image blends into the card below */
  .jp-panel-vis::after {
    content: ""; position: absolute; bottom: 0; left: 0; right: 0; height: 56px; pointer-events: none;
    background: linear-gradient(to bottom, transparent, rgba(4,6,14,0.88));
  }
  /* Parallax wrapper: absolute-fills vis, mouse (--par-x/y) + scroll-driven (--scroll-in) */
  .jp-img-wrap {
    position: absolute; inset: 0; overflow: hidden;
    transform: translate(
      calc(var(--par-x, 0) * -14px),
      calc(var(--par-y, 0) * -9px + var(--scroll-in, 0) * -22px)
    );
    transition: transform 0.18s ease-out;
    will-change: transform;
  }
  /* Oversize so parallax edges don't show */
  .jp-img-wrap img {
    width: calc(100% + 28px); height: calc(100% + 44px);
    margin: -22px -14px;
    object-fit: cover; display: block;
  }
  /* Float animation only on active panel (CSS targets .is-active ancestor) */
  .jp-panel.is-active .jp-img-wrap img {
    animation: jpImgFloat 9s ease-in-out infinite;
  }
  @keyframes jpImgFloat {
    0%,100% { transform: translateY(0px); }
    40%     { transform: translateY(-6px); }
    70%     { transform: translateY(3px); }
  }
  /* ── GEN PLACEHOLDER (no image) ──── */
  .jp-vis-gen {
    position: absolute; inset: 0; overflow: hidden;
    background:
      radial-gradient(ellipse 80% 60% at 50% 40%, color-mix(in srgb,var(--c1) 22%,transparent), transparent 70%),
      radial-gradient(ellipse 60% 80% at 20% 80%, color-mix(in srgb,var(--c2) 18%,transparent), transparent 60%),
      #060c1e;
    display: flex; align-items: center; justify-content: center;
  }
  .vis-grid {
    position: absolute; inset: 0; opacity: 0.35;
    background-image:
      linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 100% 100% at 50% 50%, #000 30%, transparent 80%);
  }
  /* Concentric glow rings */
  .vis-ring {
    position: absolute; border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--c1) 30%, transparent);
    top: 50%; left: 50%; transform: translate(-50%,-50%);
    animation: visRingPulse 3s ease-in-out infinite;
  }
  .vis-ring.r1 { width: 55%; aspect-ratio: 1; animation-delay: 0s; }
  .vis-ring.r2 { width: 75%; aspect-ratio: 1; animation-delay: .5s; border-color: color-mix(in srgb,var(--c1) 18%,transparent); }
  .vis-ring.r3 { width: 95%; aspect-ratio: 1; animation-delay: 1s; border-color: color-mix(in srgb,var(--c1) 10%,transparent); }
  @keyframes visRingPulse {
    0%,100% { opacity: 0.5; transform: translate(-50%,-50%) scale(1); }
    50% { opacity: 1; transform: translate(-50%,-50%) scale(1.03); }
  }
  /* Central orb */
  .vis-orb {
    position: absolute; width: 38%; aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, color-mix(in srgb,var(--c1) 90%,white) 0%, var(--c2) 55%, transparent 80%);
    filter: blur(3px);
    box-shadow: 0 0 60px color-mix(in srgb,var(--c1) 55%,transparent),
                0 0 120px color-mix(in srgb,var(--c1) 25%,transparent);
    animation: jpFloat 7s ease-in-out infinite;
    top: 50%; left: 50%; transform: translate(-50%,-50%);
  }
  @keyframes jpFloat { 0%,100%{top:calc(50% - 0px)} 50%{top:calc(50% - 10px)} }
  .vis-kind {
    position: absolute; bottom: 18px; left: 18px;
    font-size: 0.62rem; letter-spacing: 3px; text-transform: uppercase;
    color: color-mix(in srgb,var(--c1) 70%,white); opacity: 0.7;
  }
  .vis-num {
    position: absolute; bottom: 12px; right: 16px;
    font-size: clamp(3rem,6vw,5rem); font-weight: 900; line-height: 1;
    color: var(--c1); opacity: 0.08; letter-spacing: -0.05em;
  }

  .jp-vis-overlay {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(110% 55% at 75% 5%, color-mix(in srgb, var(--c1) 14%, transparent), transparent 55%);
  }
  /* Scan line — only on active panel */
  .jp-scan { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .jp-panel.is-active .jp-scan::before {
    content: ""; position: absolute; left: 0; right: 0; height: 1.5px; top: -2px;
    background: linear-gradient(90deg, transparent 0%, color-mix(in srgb,var(--c1) 70%,transparent) 50%, transparent 100%);
    animation: jpScan 5s linear infinite; opacity: 0.7;
  }
  @keyframes jpScan { 0%{top:-2px;opacity:0} 5%{opacity:0.7} 95%{opacity:0.5} 100%{top:100%;opacity:0} }

  /* HUD brackets */
  .hud-bracket { position: absolute; width: 18px; height: 18px; z-index: 2; pointer-events: none; }
  .hud-bracket.tl { top: 8px; left: 8px; border-top: 2px solid var(--c1); border-left: 2px solid var(--c1); opacity: 0.8; }
  .hud-bracket.br { bottom: 8px; right: 8px; border-bottom: 2px solid var(--c2); border-right: 2px solid var(--c2); opacity: 0.8; }

  .jp-glow-ring { display: none; }

  /* ── TABLET: no separate layout — covered by mobile sticky block ── */

  /* ── DESKTOP: PINNED SCROLLYTELLING ──────── */
  @media (min-width: 900px) {
    .jp-mobile-hint { display: none; }

    .jp-root { height: calc(var(--n) * 100vh); }

    .jp-sticky {
      position: sticky; top: 62px;   /* clear fixed header */
      height: calc(100dvh - 62px);
      display: grid;
      grid-template-columns: 256px 1fr;
      overflow: hidden;
    }

    /* Dot grid over full viewport */
    .jp-bg { position: absolute; }

    /* ── RAIL ───────────────────── */
    .jp-rail {
      display: flex; flex-direction: column;
      border-right: 1px solid rgba(255,255,255,0.06);
      background: rgba(4,6,14,0.92);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      z-index: 2;
      overflow: hidden;
    }
    .jp-hud-top {
      display: flex; align-items: center; justify-content: space-between;
      padding: 20px 18px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .jp-hud-label {
      font-family: var(--display); font-size: 0.6rem; letter-spacing: 3.5px;
      color: var(--accent-2); text-transform: uppercase; opacity: 0.8;
    }
    .jp-hud-counter { font-size: 0.88rem; color: var(--accent); }
    .jp-hud-sep { color: var(--border); margin: 0 2px; }

    .jp-rail-inner {
      flex: 1; overflow-y: auto; padding: 8px 0 16px;
      scrollbar-width: none;
      position: relative;
    }
    .jp-rail-inner::-webkit-scrollbar { display: none; }

    /* Vertical timeline line — left edge aligned with dots (chapter 14px + node 15px = 29px) */
    .jp-rail-line {
      position: absolute; left: 28px; top: 12px; bottom: 12px; width: 2px;
      background: rgba(255,255,255,0.07);
      border-radius: 2px;
    }
    .jp-rail-fill {
      position: absolute; left: 0; top: 0; width: 100%; height: 0%;
      background: linear-gradient(var(--accent), var(--accent-2));
      transition: height 0.15s linear;
    }

    .jp-chapter { padding: 0 14px; }
    .jp-chapter-gate {
      display: flex; align-items: center; gap: 8px;
      padding: 14px 8px 7px 26px;
    }
    .jp-chapter-gate::before {
      content: ""; width: 20px; height: 1px; background: var(--cc); opacity: 0.6;
    }
    .jp-chapter-name {
      font-family: var(--display); font-size: 0.62rem; letter-spacing: 3px;
      text-transform: uppercase; color: var(--cc); opacity: 0.9;
    }
    .jp-chapter ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }

    .jp-node {
      display: flex; align-items: center; gap: 12px;
      background: none; border: none; cursor: pointer;
      padding: 7px 10px 7px 15px; text-align: left; width: 100%;
      border-radius: 8px;
      transition: background 0.2s;
    }
    .jp-node:hover { background: rgba(255,255,255,0.04); }
    .jp-node-dot {
      width: 11px; height: 11px; border-radius: 50%;
      border: 1.5px solid color-mix(in srgb, var(--mc) 55%, var(--border));
      background: rgba(4,6,14,0.9); flex: 0 0 auto;
      transition: all 0.25s var(--ease); position: relative; z-index: 1;
    }
    .jp-node.is-active .jp-node-dot {
      background: var(--mc); border-color: var(--mc);
      box-shadow: 0 0 0 3px color-mix(in srgb,var(--mc) 25%,transparent), 0 0 12px var(--mc);
      transform: scale(1.25);
    }
    .jp-node-info { display: grid; overflow: hidden; }
    .jp-node-year { font-family: var(--mono); font-size: 0.68rem; color: var(--text-mute); }
    .jp-node-title { font-size: 0.83rem; color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: color 0.2s; }
    .jp-node.is-active .jp-node-title { color: var(--text); font-weight: 600; }
    .jp-node.is-active .jp-node-year { color: var(--mc); }

    .jp-rail-foot {
      padding: 12px 14px;
      border-top: 1px solid rgba(255,255,255,0.05);
    }
    .jp-rail-track {
      height: 2px; border-radius: 2px;
      background: rgba(255,255,255,0.07); overflow: hidden;
    }
    .jp-rail-prog {
      display: block; height: 100%; width: 0%;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      transition: width 0.15s linear;
    }

    /* ── STAGE ───────────────────── */
    .jp-stage {
      position: relative; display: block;
      padding: 0;
    }

    .jp-panel {
      position: absolute; inset: clamp(12px,1.5vh,20px) clamp(20px,3vw,40px);
      opacity: 0;
      pointer-events: none;
      /* JS sets opacity directly each RAF — no CSS delay for scroll-locked feel */
    }

    .jp-glass {
      height: 100%;
      background: rgba(4,7,20,0.94);
      border: 1px solid rgba(255,255,255,0.07);
      border-left: none;
      border-radius: 20px;
      display: grid;
      grid-template-rows: 44px 1fr;
      overflow: hidden;
      transition: border-color 0.25s, box-shadow 0.25s;
    }
    .jp-panel.is-active .jp-glass {
      border-color: color-mix(in srgb, var(--c1) 30%, rgba(255,255,255,0.07));
      box-shadow:
        0 0 0 1px color-mix(in srgb, var(--c1) 15%, transparent),
        0 0 40px color-mix(in srgb, var(--c1) 12%, transparent),
        0 0 80px color-mix(in srgb, var(--c2) 6%, transparent),
        0 24px 64px rgba(0,0,0,0.5);
    }

    .jp-panel-hud {
      padding: 0 22px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      background: rgba(0,0,0,0.25);
    }
    .jp-panel-code { font-size: 0.67rem; }

    .jp-glass { grid-template-rows: 44px 1fr; }
    .jp-panel-body {
      display: block; position: relative;
      height: 100%; aspect-ratio: unset; overflow: hidden;
    }
    .jp-panel-vis {
      position: absolute; inset: 0; height: 100%;
      border-left: none;
    }
    .jp-panel-text {
      position: absolute; inset: 0; z-index: 1;
      padding: clamp(24px,4vh,48px) clamp(36px,5vw,72px);
      display: flex; flex-direction: column; justify-content: flex-end;
      gap: 0; overflow: hidden;
      background: linear-gradient(
        to top,
        rgba(4,6,14,0.97) 0%,
        rgba(4,6,14,0.88) 28%,
        rgba(4,6,14,0.5) 50%,
        rgba(4,6,14,0.08) 72%,
        transparent 88%
      );
    }
    .jp-text-top { margin-bottom: clamp(8px,1.2vh,14px); }
    .jp-text-mid { margin-bottom: clamp(8px,1.2vh,14px); min-height: 0; }
    .jp-text-bot { /* natural flow */ }
    .jp-ghost-year {
      font-size: clamp(6rem,11vw,12rem); top: -24px; right: -6px; opacity: 0.13;
    }
    .jp-year { font-size: 0.82rem; letter-spacing: 2px; }
    .jp-title { font-size: clamp(1.8rem,3.2vw,2.8rem); }
    .jp-narr { font-size: 1rem; -webkit-line-clamp: 3; }
    .jp-bullets li { font-size: .9rem; }
    .jp-panel-vis img { object-fit: cover; }

    .hud-bracket { width: 22px; height: 22px; }
    .hud-bracket.tl { top: 12px; left: 12px; }
    .hud-bracket.br { bottom: 12px; right: 12px; }

    /* Outer glow ring */
    .jp-glow-ring {
      display: block;
      position: absolute; inset: -1px; border-radius: 21px;
      z-index: -1; pointer-events: none;
      opacity: 0;
      background: conic-gradient(from 0deg, var(--c1), var(--c2), transparent, var(--c1));
      filter: blur(10px);
      transition: opacity 0.4s;
      animation: ringRotate 5s linear infinite paused;
    }
    .jp-panel.is-active .jp-glow-ring {
      opacity: 0.28;
      animation-play-state: running;
    }
    @keyframes ringRotate { to { transform: rotate(360deg); } }
  }

  /* ── LARGE DESKTOP ───────────────────── */
  @media (min-width: 1200px) {
    .jp-sticky { grid-template-columns: 292px 1fr; }
    .jp-panel { inset: clamp(24px,3vh,36px) clamp(28px,4vw,56px); }
    .jp-title { font-size: clamp(2rem,3.5vw,3.2rem); }
    .jp-ghost-year { font-size: clamp(7rem,13vw,14rem); }
    .jp-narr { -webkit-line-clamp: 4; }
    .jp-node { padding: 8px 12px 8px 16px; }
    .jp-node-title { font-size: 0.86rem; }
    .jp-node-year { font-size: 0.7rem; }
  }

  /* ── MOBILE STICKY (< 900px) — same scrollytelling UX, no rail ── */
  @media (max-width: 899px) {
    .jp-root { height: calc(var(--n) * 100vh); }
    .jp-sticky {
      position: sticky; top: 62px;
      height: calc(100dvh - 62px);
      overflow: hidden; display: block;
    }
    .jp-stage { position: relative; display: block; padding: 0; }
    .jp-panel { position: absolute; inset: 6px 10px; opacity: 0; pointer-events: none; }
    /* Show first panel instantly — JS takes over on astro:page-load */
    .jp-panel[data-panel="0"] { opacity: 1; pointer-events: auto; }
    .jp-glass {
      height: 100%;
      grid-template-rows: 40px 1fr;
    }
    .jp-glass::before { display: none; }
    .jp-panel-body {
      display: block; position: relative;
      height: 100%; overflow: hidden;
      aspect-ratio: unset; min-height: 0;
    }
    .jp-panel-vis {
      order: 0; position: absolute; inset: 0; height: 100%;
      aspect-ratio: unset; min-height: 0; flex-shrink: initial;
    }
    .jp-panel-vis::after { display: none; }
    .jp-panel-text {
      position: absolute; inset: 0; z-index: 1;
      padding: 12px 14px 20px;
      display: flex; flex-direction: column; justify-content: flex-end;
      gap: 7px; overflow: hidden;
      background: linear-gradient(
        to top,
        rgba(4,6,14,0.97) 0%,
        rgba(4,6,14,0.9) 26%,
        rgba(4,6,14,0.52) 50%,
        rgba(4,6,14,0.08) 72%,
        transparent 88%
      );
    }
    .jp-panel.is-active .jp-glass {
      box-shadow:
        0 0 0 1px color-mix(in srgb, var(--c1) 20%, transparent),
        0 0 28px color-mix(in srgb, var(--c1) 14%, transparent);
    }
    .jp-mobile-hint { display: none; }

    /* Text sizing */
    .jp-panel-hud { padding: 8px 12px; gap: 7px; }
    .jp-panel-code { font-size: 0.58rem; letter-spacing: 2px; }
    .jp-panel-chapter-tag { font-size: 0.57rem; color: var(--c1); opacity: 0.85; }
    .jp-panel-frac { font-size: 0.62rem; }
    .jp-title { font-size: 1.1rem; font-weight: 700; letter-spacing: -0.02em; }
    .jp-year { font-size: 0.64rem; letter-spacing: 2px; margin-bottom: 4px; }
    .jp-ghost-year { display: none; }
    .jp-narr {
      display: -webkit-box; -webkit-line-clamp: 3;
      -webkit-box-orient: vertical; overflow: hidden;
      font-size: 0.82rem; line-height: 1.6;
    }
    .jp-chip { font-size: 0.68rem; padding: 2px 7px; }
    .jp-bullets { gap: 3px; }
    .jp-bullets li { font-size: 0.76rem; line-height: 1.35; }
    .jp-bullets li::before { font-size: 0.65rem; }
    .hud-bracket { width: 12px; height: 12px; }
    .hud-bracket.tl { top: 5px; left: 5px; }
    .hud-bracket.br { bottom: 5px; right: 5px; }
  }

  @media (max-width: 599px) {
    .jp-title { font-size: 1rem; }
    .jp-narr { font-size: 0.79rem; }
    .jp-panel-text { padding: 11px 12px 16px; }
    .jp-panel-hud { padding: 7px 11px; }
  }

  /* ── REDUCED MOTION ─────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .vis-orb { animation: none; }
    .jp-scan::before { animation: none; }
    .jp-glow-ring { animation: none !important; }
    .jp-panel { transition: opacity 0.3s; transform: none !important; }
    .jp-img-wrap img { animation: none; }
    .jp-img-wrap { transform: none !important; }
  }
</style>

<script>
  function setupJourneyPinned() {
    const root = document.querySelector<HTMLElement>('[data-jp]');
    if (!root) return;

    const panels   = Array.from(root.querySelectorAll<HTMLElement>('.jp-panel'));
    const nodes    = Array.from(root.querySelectorAll<HTMLElement>('.jp-node'));
    const counter  = root.querySelector<HTMLElement>('[data-jp-cur]');
    const fills    = Array.from(root.querySelectorAll<HTMLElement>('[data-jp-fill]'));
    const progBars = Array.from(root.querySelectorAll<HTMLElement>('.jp-rail-prog'));
    const n = panels.length;
    if (!n) return;

    // JS-driven image queue: all panels overlap in viewport (absolute stacked),
    // so native loading="lazy" doesn't defer anything. We strip src from non-first
    // panels and restore it progressively as panels activate.
    const imgQueue = new Map<number, HTMLImageElement[]>();
    panels.forEach((panel, i) => {
      if (i === 0) return; // keep first panel loaded (fetchpriority=high)
      const imgs = Array.from(panel.querySelectorAll<HTMLImageElement>('img'));
      imgs.forEach(img => {
        const src = img.getAttribute('src');
        if (src) { img.dataset.src = src; img.removeAttribute('src'); }
      });
      if (imgs.length) imgQueue.set(i, imgs);
    });
    function loadPanel(i: number) {
      const imgs = imgQueue.get(i);
      if (!imgs) return;
      imgs.forEach(img => { if (img.dataset.src) img.src = img.dataset.src; });
      imgQueue.delete(i);
    }

    let activeIdx   = -1;
    let scrollTick  = false;
    let resizeTick  = false;
    // Cache layout — recomputed only on resize, not every scroll frame
    let rootTop     = 0;
    let scrollTotal = 0;

    function measureLayout() {
      // Walk offsetParent chain — safe after View Transitions settle
      let el: HTMLElement | null = root, t = 0;
      while (el) { t += el.offsetTop; el = el.offsetParent as HTMLElement | null; }
      rootTop     = t;
      scrollTotal = root.offsetHeight - window.innerHeight;
    }

    // render(): scroll-driven, called every RAF — opacity tied 1:1 to scroll position
    function render(scrolled: number) {
      const p       = scrolled / scrollTotal;
      // clamp raw to avoid floor hitting n
      const raw     = Math.min(p * n, n - 0.0001);
      const i       = Math.floor(raw);
      const inPanel = raw - i;          // 0 → 1 within panel i
      const BLEND   = 0.25;            // last 25% of each panel is crossfade zone

      fills.forEach(f => { f.style.height = (p * 100).toFixed(1) + '%'; });
      progBars.forEach(b => { b.style.width  = (p * 100).toFixed(1) + '%'; });

      // Opacity: directly scroll-locked, no CSS transition
      panels.forEach((el, k) => {
        let op = 0;
        if (k === i)     op = inPanel < (1 - BLEND) ? 1 : (1 - inPanel) / BLEND;
        else if (k === i + 1) op = inPanel < (1 - BLEND) ? 0 : (inPanel - (1 - BLEND)) / BLEND;
        const v = Math.max(0, Math.min(1, op));
        el.style.opacity      = v <= 0 ? '0' : v.toFixed(3);
        el.style.pointerEvents = v > 0.5 ? 'auto' : 'none';
        // Promote only panels currently in transition
        el.style.willChange   = (k === i || k === i + 1) ? 'opacity' : 'auto';
      });

      // Parallax scroll-in for current panel
      panels[i]?.style.setProperty('--scroll-in', ((inPanel - 0.5) * 2).toFixed(3));

      // is-active switches at the blend midpoint (50% through crossfade)
      const newActive = inPanel > (1 - BLEND * 0.5) ? Math.min(n - 1, i + 1) : i;
      if (counter) counter.textContent = String(newActive + 1).padStart(2, '0');

      if (newActive !== activeIdx) {
        activeIdx = newActive;
        panels.forEach((el, k) => el.classList.toggle('is-active', k === newActive));
        nodes.forEach((el, k)  => el.classList.toggle('is-active', k === newActive));
        for (let k = Math.max(0, newActive - 1); k <= Math.min(n - 1, newActive + 2); k++) loadPanel(k);
        nodes[newActive]?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }

    function onScroll() {
      if (scrollTick) return;
      scrollTick = true;
      requestAnimationFrame(() => {
        if (scrollTotal <= 0) { scrollTick = false; return; }
        render(Math.max(0, Math.min(window.scrollY - rootTop, scrollTotal)));
        scrollTick = false;
      });
    }

    function onResize() {
      if (resizeTick) return;
      resizeTick = true;
      requestAnimationFrame(() => {
        measureLayout();
        onScroll();
        resizeTick = false;
      });
    }

    nodes.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        const y = rootTop + ((i + 0.5) / n) * scrollTotal;
        window.scrollTo({ top: y, behavior: 'smooth' });
      });
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });
    measureLayout();
    onScroll();
  }

  document.addEventListener('astro:page-load', setupJourneyPinned);
</script>
