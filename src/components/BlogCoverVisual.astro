---
/**
 * BlogCoverVisual — Abstract CSS visual seeded from slug + coverKeywords.
 * No images, no external deps. Adapts to current data-palette.
 * size: 'thumb' (list) | 'header' (detail page)
 */
interface Props {
  slug: string;
  coverKeywords?: string[];
  coverImage?: string | null;
  size?: 'thumb' | 'header';
  class?: string;
}

const { slug, coverKeywords = [], coverImage, size = 'thumb', class: cls = '' } = Astro.props;

// Deterministic hash from slug → drives visual variation
function hashStr(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = Math.imul(31, h) + s.charCodeAt(i) | 0;
  return Math.abs(h);
}

const h = hashStr(slug);
// 5 accent combos cycling through palette-aware gradients
const combo = h % 5;
const angle = 108 + (h % 60) - 30;
// Ring size variation
const r1 = 42 + (h % 18);
const r2 = 62 + ((h >> 4) % 18);
const orbX = 30 + (h % 40);
const orbY = 25 + ((h >> 3) % 40);
// Keyword hint — first keyword shown faintly
const kw = coverKeywords[0] ?? '';
---

<div
  class:list={['bcv', `bcv--${size}`, `bcv--c${combo}`, cls]}
  aria-hidden="true"
  style={`--angle:${angle}deg;--r1:${r1}%;--r2:${r2}%;--ox:${orbX}%;--oy:${orbY}%`}
>
  {coverImage ? (
    <img src={coverImage} alt="" loading="lazy" decoding="async" class="bcv-img" />
  ) : (
    <>
      <span class="bcv-grid"></span>
      <span class="bcv-ring r1"></span>
      <span class="bcv-ring r2"></span>
      <span class="bcv-orb"></span>
      <span class="bcv-lines"></span>
      {kw && size === 'header' && <span class="bcv-kw mono">{kw}</span>}
    </>
  )}
  <span class="bcv-overlay"></span>
</div>

<style>
  .bcv {
    position: relative;
    overflow: hidden;
    background: var(--bg-card);
    border-radius: 10px;
    flex-shrink: 0;
  }

  /* Thumb: square chip for list */
  .bcv--thumb {
    width: 72px;
    height: 72px;
    border-radius: 10px;
    border: 1px solid var(--border);
  }

  /* Header: wide band above article */
  .bcv--header {
    width: 100%;
    height: 160px;
    border-radius: 12px;
    border: 1px solid var(--border);
  }
  @media (min-width: 600px) {
    .bcv--header { height: 200px; }
  }

  /* Shared background gradient — 5 combos using CSS vars */
  .bcv--c0 { --g1: var(--accent); --g2: var(--accent-2); }
  .bcv--c1 { --g1: var(--accent-2); --g2: var(--accent-3); }
  .bcv--c2 { --g1: var(--accent-3); --g2: var(--accent); }
  .bcv--c3 { --g1: var(--accent); --g2: var(--accent-3); }
  .bcv--c4 { --g1: var(--accent-2); --g2: var(--accent); }

  /* Dot grid */
  .bcv-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--g1) 6%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--g1) 6%, transparent) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  /* Concentric rings */
  .bcv-ring {
    position: absolute;
    border-radius: 50%;
    top: var(--oy); left: var(--ox);
    transform: translate(-50%, -50%);
    border: 1px solid color-mix(in srgb, var(--g1) 28%, transparent);
    animation: bcvPulse 4s ease-in-out infinite;
  }
  .bcv-ring.r1 { width: var(--r1); aspect-ratio: 1; }
  .bcv-ring.r2 { width: var(--r2); aspect-ratio: 1; animation-delay: 0.7s; border-color: color-mix(in srgb, var(--g2) 18%, transparent); }
  @keyframes bcvPulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  /* Central orb */
  .bcv-orb {
    position: absolute;
    width: 28%; aspect-ratio: 1;
    top: var(--oy); left: var(--ox);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--g1) 90%, white) 0%, var(--g2) 55%, transparent 80%);
    filter: blur(4px);
    box-shadow: 0 0 40px color-mix(in srgb, var(--g1) 40%, transparent);
    animation: bcvFloat 7s ease-in-out infinite;
  }
  @keyframes bcvFloat { 0%,100%{top:var(--oy)} 50%{top:calc(var(--oy) - 5%)} }

  /* Diagonal accent lines */
  .bcv-lines {
    position: absolute; inset: 0;
    background:
      repeating-linear-gradient(
        var(--angle),
        transparent 0px,
        transparent 18px,
        color-mix(in srgb, var(--g1) 5%, transparent) 18px,
        color-mix(in srgb, var(--g1) 5%, transparent) 19px
      );
    opacity: 0.6;
  }

  /* Top-right gradient wash */
  .bcv-overlay {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 80% 10%, color-mix(in srgb, var(--g2) 18%, transparent), transparent 60%),
      linear-gradient(to bottom, transparent 60%, color-mix(in srgb, var(--bg) 80%, transparent) 100%);
    pointer-events: none;
  }

  /* Keyword hint text — header only */
  .bcv-kw {
    position: absolute; bottom: 12px; left: 16px;
    font-size: 0.62rem; letter-spacing: 3px; text-transform: uppercase;
    color: color-mix(in srgb, var(--g1) 60%, white); opacity: 0.55;
  }

  /* Real image */
  .bcv-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: top left; display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .bcv-ring, .bcv-orb { animation: none; }
  }
</style>
