---
import Base from '../layouts/Base.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import { getProfile, getLatestExpUpdate } from '../lib/content';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfile(lang);
const experience = profile.experience ?? [];
const personal = profile.personalProjects ?? [];
const education = profile.education ?? [];
const expUpdate = getLatestExpUpdate();
---
<Base title={t('exp.title')} description={profile.summary}>
  <section style="padding-top:56px">
    <div class="container">
      <p class="eyebrow">{t('exp.eyebrow')}</p>
      <h1 class="section-title" style="font-size:2rem">{t('exp.title')}</h1>
      <p class="section-sub">{t('exp.sub', { n: profile.identity.yearsExperience })}</p>

      {expUpdate && (
        <div class="card" style="border-color:var(--accent-2);margin-bottom:28px">
          <div style="display:flex;gap:10px;align-items:center;margin-bottom:8px;flex-wrap:wrap">
            <span class="chip accent">Skill snapshot · {expUpdate.date}</span>
            <span class="muted" style="font-size:.85rem">{t('exp.byGrok')}</span>
          </div>
          {expUpdate.summary && <p style="margin:0 0 .6em">{expUpdate.summary}</p>}
          {expUpdate.skills && expUpdate.skills.length > 0 && (
            <div class="chips" style="margin-bottom:10px">
              {expUpdate.skills.map((s: string) => <span class="chip">{s}</span>)}
            </div>
          )}
          {expUpdate.highlights && expUpdate.highlights.length > 0 && (
            <ul style="margin:0;padding-left:18px;color:#cfd6ea">
              {expUpdate.highlights.map((h: string) => <li>{h}</li>)}
            </ul>
          )}
        </div>
      )}

      <div class="grid" style="gap:22px">
        {experience.map((e: any) => (
          <ExperienceCard
            company={e.company}
            role={e.role}
            location={e.location}
            start={e.start}
            end={e.end}
            current={e.current}
            projects={e.projects}
          />
        ))}
      </div>
    </div>
  </section>

  {personal.length > 0 && (
    <section style="padding-top:0">
      <div class="container">
        <p class="eyebrow">{t('exp.side.eyebrow')}</p>
        <h2 class="section-title">{t('exp.side.title')}</h2>
        <div class="grid grid-2" style="margin-top:22px">
          {personal.map((p: any) => (
            <article class="card">
              <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px">
                <strong>{p.name}</strong>
                <span class="mono muted" style="font-size:.78rem">{p.period}</span>
              </div>
              <p class="muted" style="margin:.5em 0">{p.summary}</p>
              <div class="chips" style="margin-bottom:10px">{(p.stack ?? []).map((s: string) => <span class="chip">{s}</span>)}</div>
              <div style="display:flex;gap:14px;flex-wrap:wrap">
                {Object.entries(p.links ?? {}).map(([k, v]) => (
                  <a href={v as string} target="_blank" rel="noopener" class="mono" style="font-size:.8rem">{k} ↗</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {education.length > 0 && (
    <section style="padding-top:0">
      <div class="container">
        <p class="eyebrow">{t('exp.edu.eyebrow')}</p>
        <h2 class="section-title">{t('exp.edu.title')}</h2>
        <div class="grid grid-2" style="margin-top:22px">
          {education.map((ed: any) => (
            <div class="card">
              <strong>{ed.school}</strong>
              {ed.org && <p class="muted" style="margin:.2em 0 0;font-size:.85rem">{ed.org}</p>}
              <p style="margin:.4em 0 0;color:var(--accent-2)">{ed.degree}</p>
              <p class="mono muted" style="margin:.2em 0 0;font-size:.82rem">{ed.period}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
