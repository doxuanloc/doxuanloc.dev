---
import Base from '../../layouts/Base.astro';
import { getAllPosts } from '../../lib/content';
import { getLangFromUrl, useTranslations, localizedPath } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = getAllPosts();
---
<Base title={t('blog.title')} description={t('blog.title')}>
  <section style="padding-top:56px">
    <div class="container">
      <p class="eyebrow">{t('blog.eyebrow')}</p>
      <h1 class="section-title" style="font-size:2rem">{t('blog.title')}</h1>
      <p class="section-sub">{t('blog.sub', { n: posts.length })}</p>

      {posts.length === 0 ? (
        <div class="card muted">{t('blog.empty')}</div>
      ) : (
        <div class="grid" style="gap:14px">
          {posts.map((p) => (
            <a href={localizedPath(`/blog/${p.slug}`, lang)} class="card" style="text-decoration:none;color:inherit">
              <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px">
                <strong style="font-size:1.15rem">{p.title}</strong>
                <span class="mono muted" style="font-size:.78rem;white-space:nowrap">{p.date}</span>
              </div>
              <p class="muted" style="margin:.5em 0 .6em">{p.excerpt}</p>
              <div style="display:flex;justify-content:space-between;align-items:center">
                <div class="chips">{(p.tags ?? []).map((tag) => <span class="chip">{tag}</span>)}</div>
                {p.readingTimeMin && <span class="mono muted" style="font-size:.78rem">{t('common.readmin', { n: p.readingTimeMin })}</span>}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
