---
import Base from '../../layouts/Base.astro';
import { getAllPosts, getProfile } from '../../lib/content';
import { getLangFromUrl, useTranslations, localizedPath } from '../../i18n/ui';
import { marked } from 'marked';

export function getStaticPaths() {
  return getAllPosts().map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfile(lang);
const { post } = Astro.props;
const html = marked.parse(post.contentMarkdown ?? '', { async: false }) as string;

const siteOrigin = (Astro.site ?? new URL('https://doxuanloc.space')).toString().replace(/\/$/, '');
const postUrl = `${siteOrigin}/blog/${post.slug}/`;
const postImage = post.coverImage
  ? (post.coverImage.startsWith('http') ? post.coverImage : `${siteOrigin}${post.coverImage}`)
  : `${siteOrigin}/images/hero-astronaut.webp`;

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  keywords: (post.tags ?? []).join(', '),
  inLanguage: lang === 'vi' ? 'vi' : 'en',
  image: postImage,
  url: postUrl,
  author: { '@type': 'Person', name: profile.identity.name, url: `${siteOrigin}/` },
  publisher: { '@type': 'Person', name: profile.identity.name, url: `${siteOrigin}/` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
};
---
<Base
  title={post.title}
  description={post.excerpt}
  image={post.coverImage ?? undefined}
  schema={blogLd}
  ogType="article"
  articleMeta={{ publishedTime: post.date, tags: post.tags ?? [] }}
>
  <div class="read-progress" id="read-progress"></div>
  <section style="padding-top:56px">
    <div class="container">
      <a href={localizedPath('/blog', lang)} class="mono muted" style="font-size:.85rem">← {t('nav.blog')}</a>
      <p class="eyebrow" style="margin-top:18px">{post.date}{post.readingTimeMin ? ` · ${t('common.readmin', { n: post.readingTimeMin })}` : ''}</p>
      <h1 style="font-size:clamp(1.8rem,4vw,2.6rem);line-height:1.15;margin:.1em 0 .3em">{post.title}</h1>
      <div class="chips" style="margin-bottom:8px">{(post.tags ?? []).map((tag) => <span class="chip">{tag}</span>)}</div>

      <article class="prose" set:html={html} />

      <hr style="border:none;border-top:1px solid var(--border);margin:40px 0 20px" />
      <p class="muted" style="font-size:.85rem">
        {t('blog.backToGrok')}
      </p>
    </div>
  </section>
</Base>
