---
import Base from '../../layouts/Base.astro';
import { getAllPosts, getAllSlugs, getPostBySlug, getPostNativeLocales, getProfile } from '../../lib/content';
import { getLangFromUrl, useTranslations, localizedPath } from '../../i18n/ui';
import BlogCoverVisual from '../../components/BlogCoverVisual.astro';
import ContentBlocks from '../../components/blog/ContentBlocks.astro';
import { marked } from 'marked';

export function getStaticPaths() {
  return getAllSlugs().map((slug) => ({ params: { slug } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { slug } = Astro.params;
const post = getPostBySlug(slug, lang)!;
const profile = getProfile(lang);
const md = post.contentMarkdown ?? '';
const rawSections = md.split(/(?=^##\s)/m).map((s) => s.trim()).filter(Boolean);
const sections = (rawSections.length ? rawSections : [md]).map((s) => marked.parse(s, { async: false }) as string);
const blocks = post.blocks ?? [];

const siteOrigin = (Astro.site ?? new URL('https://doxuanloc.space')).toString().replace(/\/$/, '');
// Locale-aware URL — matches canonical (no trailing slash)
const postPath = localizedPath(`/blog/${post.slug}`, lang);
const postUrl = `${siteOrigin}${postPath}`;
const postImage = post.coverImage
  ? (post.coverImage.startsWith('http') ? post.coverImage : `${siteOrigin}${post.coverImage}`)
  : `${siteOrigin}/images/hero-astronaut.webp`;

// Locales that have real translated content (not VI fallback)
const nativeLocales = getPostNativeLocales(post.slug);
const isTranslated = nativeLocales.includes(lang);
// inLanguage reflects actual content language (VI is source; only change if translated variant exists)
const contentLang = lang === 'vi' ? 'vi' : nativeLocales.includes(lang) ? (lang === 'ja' ? 'ja' : 'en') : 'vi';
// ISO 8601 date string for schema (date field is YYYY-MM-DD)
const isoDate = post.date ? `${post.date}T00:00:00+07:00` : undefined;

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: isoDate,
  dateModified: isoDate,
  keywords: (post.tags ?? []).join(', '),
  inLanguage: contentLang,
  image: postImage,
  url: postUrl,
  author: { '@type': 'Person', name: profile.identity.name, url: `${siteOrigin}/` },
  publisher: { '@type': 'Person', name: profile.identity.name, url: `${siteOrigin}/` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
};

const aiPrompts = lang === 'vi'
  ? ['Tóm tắt bài viết', 'Giải thích thêm', 'Liên quan gì đến tôi?', 'Góc nhìn khác']
  : lang === 'ja'
  ? ['この記事を要約', 'さらに詳しく', '自分に関係ある？', '別の視点']
  : ['Summarise this post', 'Explain further', 'How does this apply to me?', 'Alternative views'];
const aiPlaceholder = lang === 'vi' ? 'Hỏi về bài viết này…' : lang === 'ja' ? 'この記事について質問…' : 'Ask about this post…';
---
<Base
  title={post.title}
  description={post.excerpt}
  image={post.coverImage ?? undefined}
  schema={blogLd}
  ogType="article"
  articleMeta={{ publishedTime: isoDate, tags: post.tags ?? [] }}
  noindex={!isTranslated}
  availableLocales={nativeLocales}
>
  <div class="read-progress" id="read-progress"></div>

  <section class="article-section">
    <div class="container article-layout">

      {/* Back link */}
      <a href={localizedPath('/blog', lang)} class="back-link mono">
        ← {t('nav.blog')}
      </a>

      {/* Cover visual */}
      <BlogCoverVisual slug={post.slug} coverKeywords={post.coverKeywords} coverImage={post.coverImage} size="header" />

      {/* Article header */}
      <header class="article-header" data-reveal>
        <div class="meta-row article-meta">
          <time datetime={post.date} class="article-date">{post.date}</time>
          {post.readingTimeMin && (
            <><span class="sep">·</span><span>{t('common.readmin', { n: post.readingTimeMin })}</span></>
          )}
        </div>
        <h1 class="article-title">{post.title}</h1>
        {post.excerpt && <p class="article-lede">{post.excerpt}</p>}
        {post.interactiveBlock && <div class="article-interactive" set:html={post.interactiveBlock} />}
        <div class="chips article-tags" style="margin-top:10px">
          {(post.tags ?? []).map((tag) => <span class="chip">{tag}</span>)}
        </div>
        <div class="aurora-line" style="margin-top:20px"></div>
      </header>

      {/* TL;DR — 10s catch-up */}
      {post.tldr && post.tldr.length > 0 && (
        <aside class="article-tldr" data-reveal>
          <div class="tldr-head mono">TL;DR</div>
          <ul>{post.tldr.map((t) => <li>{t}</li>)}</ul>
        </aside>
      )}

      {/* Article body — prose sections interleaved with data-driven blocks */}
      <div class="article-body" data-reveal style="--reveal-delay:60ms">
        {sections.map((sec, i) => (
          <>
            <article class="prose article-prose" set:html={sec} />
            {blocks[i] && <ContentBlocks blocks={[blocks[i]]} />}
          </>
        ))}
        {blocks.length > sections.length && <ContentBlocks blocks={blocks.slice(sections.length)} />}
      </div>

      {/* AI discussion slot */}
      <div class="ai-slot article-ai-slot" data-reveal style="--reveal-delay:80ms">
        <div class="ai-slot-header">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          {lang === 'vi' ? 'Thảo luận với AI' : lang === 'ja' ? 'AIと議論する' : 'Discuss with AI'}
        </div>
        <div class="ai-slot-prompts">
          {aiPrompts.map((p) => <button class="chip" disabled>{p}</button>)}
        </div>
        <div class="ai-slot-bar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <span>{aiPlaceholder}</span>
        </div>
      </div>

      {/* Footer */}
      <footer class="article-footer">
        <div class="aurora-line"></div>
        <div class="article-foot-row">
          <a href={localizedPath('/blog', lang)} class="back-link mono">← {t('nav.blog')}</a>
          <p class="muted article-grok-note" style="font-size:.82rem;margin:0">{t('blog.backToGrok')}</p>
        </div>
      </footer>

    </div>
  </section>
</Base>

<style>
  .article-section { padding-top: 48px; padding-bottom: 60px; }
  .article-layout { max-width: 740px; display: flex; flex-direction: column; gap: 28px; }

  .back-link { font-size: 0.83rem; color: var(--text-mute); text-decoration: none; transition: color 0.15s; }
  .back-link:hover { color: var(--accent-2); }

  /* Header */
  .article-header { display: flex; flex-direction: column; }
  .article-meta { font-size: 0.76rem; }
  .article-date { font-size: 0.76rem; }

  .article-title {
    font-size: clamp(1.85rem, 4.5vw, 2.6rem);
    line-height: 1.14; letter-spacing: -0.03em;
    margin: 6px 0 0; font-weight: 800;
  }
  .article-lede {
    font-size: 1.08rem; color: var(--text-dim); line-height: 1.6;
    margin: 10px 0 0; font-style: italic;
  }
  .article-interactive {
    margin: 20px 0 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  /* TL;DR box */
  .article-tldr {
    border: 1px solid var(--border); border-left: 3px solid var(--accent-2);
    border-radius: 0 12px 12px 0; padding: 16px 20px;
    background: color-mix(in srgb, var(--accent-2) 5%, transparent);
  }
  .tldr-head { font-size: 0.7rem; letter-spacing: 2px; color: var(--accent-2); text-transform: uppercase; margin-bottom: 8px; }
  .article-tldr ul { margin: 0; padding-left: 18px; }
  .article-tldr li { font-size: 0.95rem; line-height: 1.55; color: var(--text-dim); margin-bottom: 5px; }
  .article-body { display: flex; flex-direction: column; }

  /* Prose overrides for reading comfort */
  .article-prose {
    font-size: 1.01rem; line-height: 1.82;
    color: #cdc8be;
  }
  .article-prose :global(h2) {
    font-size: 1.38rem; font-weight: 700; margin-top: 2em;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border-soft);
  }
  .article-prose :global(h3) { font-size: 1.12rem; font-weight: 700; margin-top: 1.7em; }
  .article-prose :global(p) { margin: 0 0 1.2em; }
  .article-prose :global(li) { margin-bottom: 0.35em; }
  .article-prose :global(blockquote) {
    border-left: 3px solid var(--accent); padding: 4px 0 4px 18px;
    margin: 1.4em 0; color: var(--text-dim); font-style: italic;
    background: rgba(224,112,77,0.04); border-radius: 0 6px 6px 0;
  }
  .article-prose :global(a) { color: var(--accent-2); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(235,179,107,0.4); }
  .article-prose :global(a:hover) { text-decoration-color: var(--accent-2); }

  /* AI slot */
  .article-ai-slot { margin-top: 4px; }

  /* Footer */
  .article-footer { display: flex; flex-direction: column; gap: 16px; }
  .article-foot-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

  @media (max-width: 600px) {
    .article-section { padding-top: 36px; padding-bottom: 48px; }
    .article-prose { font-size: 0.97rem; line-height: 1.75; }
    .article-prose :global(h2) { font-size: 1.22rem; }
    .article-foot-row { flex-direction: column; gap: 8px; }
  }
</style>
