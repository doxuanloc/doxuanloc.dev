---
import Base from '../layouts/Base.astro';
import { getProfile } from '../lib/content';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfile(lang);
const id = profile.identity;
const languages = profile.languages ?? [];
---
<Base title={t('about.title')} description={profile.summary}>
  <section style="padding-top:56px">
    <div class="container" style="max-width:760px">
      <p class="eyebrow">{t('about.eyebrow')}</p>
      <h1 class="section-title" style="font-size:2rem">{t('about.title')}</h1>
      <p style="font-size:1.08rem;color:#d4dbee">{profile.summary}</p>

      <div class="grid grid-2" style="margin-top:28px">
        <div class="card">
          <strong style="color:var(--accent-2)">{t('about.contact')}</strong>
          <ul style="list-style:none;padding:0;margin:12px 0 0;display:grid;gap:8px">
            <li><a href={`mailto:${id.email}`}>{id.email}</a></li>
            <li class="mono muted">{id.phone}</li>
            <li><a href={id.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
            {id.links.currentPortfolio && <li><a href={id.links.currentPortfolio} target="_blank" rel="noopener">{t('about.oldPortfolio')}</a></li>}
          </ul>
        </div>
        <div class="card">
          <strong style="color:var(--accent-2)">{t('about.languages')}</strong>
          <ul style="list-style:none;padding:0;margin:12px 0 0;display:grid;gap:8px">
            {languages.map((l: any) => (
              <li style="display:flex;justify-content:space-between"><span>{l.name}</span><span class="muted mono" style="font-size:.82rem">{l.level}</span></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="card" style="margin-top:18px">
        <strong style="color:var(--accent-2)">{t('about.meta.title')}</strong>
        <p class="muted" style="margin:12px 0 0" set:html={t('about.meta.body')}></p>
      </div>
    </div>
  </section>
</Base>
