---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Roadmap from '../components/Roadmap.astro';
import HomeIngress from '../components/home/HomeIngress.astro';
import { getProfile, getAllPosts, getAllNews } from '../lib/content';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfile(lang);
const latestPosts = getAllPosts().slice(0, 3);
const latestNews = getAllNews().slice(0, 4);
const skills = profile.skills as Record<string, string[]>;
const solves: any[] = profile.solves ?? [];
const journeyLen = (profile.journey ?? []).length;
const currentFocus = (profile.roadmap ?? []).find((r: any) => r.status === 'in-progress');

const solveAccents = ['#5b8cff', '#36d6c3', '#b58cff', '#f0b232'];

const skillGroups = [
  { label: 'Frontend',     key: 'frontend',    c: '#36d6c3' },
  { label: 'Backend',      key: 'backend',     c: '#5b8cff' },
  { label: 'Cloud/DevOps', key: 'cloud_devops',c: '#b58cff' },
  { label: 'AI / ML',      key: 'ai_ml',       c: '#f0b232' },
  { label: 'Practices',    key: 'practices',   c: '#ff7eb3' },
];
const totalSkills = Object.values(skills).flat().length;
const totalGroups = skillGroups.filter(g => (skills[g.key] ?? []).length > 0).length;
---
<Base>
  <Hero />

  <!-- ── MANIFESTO ─────────────────────────────── -->
  <div class="manifesto" data-reveal>
    <div class="container">
      <ul class="manifesto-lines" role="list">
        <li><span class="mf-num mono">01</span><span class="mf-text grad-text">{t('home.manifesto.l1')}</span></li>
        <li><span class="mf-num mono">02</span><span class="mf-text">{t('home.manifesto.l2')}</span></li>
        <li><span class="mf-num mono">03</span><span class="mf-text muted">{t('home.manifesto.l3')}</span></li>
      </ul>
    </div>
  </div>

  <!-- ── PROBLEMS I SOLVE ──────────────────────── -->
  <section class="section-solve">
    <div class="container">
      <p class="eyebrow" data-reveal>{t('home.solve.eyebrow')}</p>
      <h2 class="section-title" data-reveal style="--reveal-delay:60ms">{t('home.solve.title')}</h2>
      <p class="section-sub" data-reveal style="--reveal-delay:100ms">{t('home.solve.sub')}</p>
      <div class="solve-grid">
        {solves.map((s, i) => (
          <div
            class="solve-card"
            data-reveal
            data-tilt
            data-chargeable
            style={`--reveal-delay:${i * 80 + 120}ms; --sc:${solveAccents[i % solveAccents.length]}; --charge: var(--solve-charge-${i})`}
          >
            <span class="solve-ghost-num mono">{String(i + 1).padStart(2, '0')}</span>
            <div class="solve-body">
              <h3 class="solve-problem">{s.problem}</h3>
              <p class="solve-approach">{s.approach}</p>
              <div class="chips" style="margin-top:12px">
                {(s.stack ?? []).map((tag: string) => (
                  <span class="chip" style={`border-color:color-mix(in srgb,${solveAccents[i % solveAccents.length]} 35%,var(--border));color:${solveAccents[i % solveAccents.length]}`}>{tag}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TECH DNA ──────────────────────────────── -->
  <section class="section-skills" style="padding-top:0">
    <div class="container">
      <p class="eyebrow" data-reveal>{t('home.skills.eyebrow')}</p>
      <h2 class="section-title" data-reveal style="--reveal-delay:60ms">{t('home.skills.title')}</h2>
      <p class="section-sub" data-reveal style="--reveal-delay:100ms">{t('home.skills.sub')}</p>

      <div class="dna-grid">
        {skillGroups.filter(g => (skills[g.key] ?? []).length > 0).map((g, i) => (
          <div class="dna-row" data-reveal style={`--reveal-delay:${i * 70 + 120}ms; --dc:${g.c}`}>
            <div class="dna-label">
              <span class="dna-dot"></span>
              <span class="dna-cat">{g.label}</span>
              <span class="dna-count mono">{(skills[g.key] ?? []).length}</span>
            </div>
            <div class="dna-chips">
              {(skills[g.key] ?? []).map((s: string) => <span class="chip dna-chip">{s}</span>)}
            </div>
          </div>
        ))}
      </div>

      <p class="dna-total mono" data-reveal>
        {t('home.skills.total', { n: totalSkills, g: totalGroups })}
      </p>
    </div>
  </section>

  <!-- ── CURRENT MISSION ───────────────────────── -->
  {currentFocus && (
    <div class="mission-bar" data-reveal>
      <div class="container">
        <div class="mission-inner">
          <div class="mission-status">
            <span class="mission-pulse"></span>
            <span class="eyebrow" style="margin:0">{t('home.focus.eyebrow')}</span>
          </div>
          <div class="mission-body">
            <span class="mission-label grad-text">{currentFocus.label}</span>
            <span class="mission-story muted">{currentFocus.story}</span>
          </div>
          <a href="#roadmap" class="btn btn-ghost mission-cta">{t('home.focus.cta')}</a>
        </div>
      </div>
    </div>
  )}

  <!-- ── JOURNEY TEASER ────────────────────────── -->
  <section class="section-journey-teaser" style="padding-top:0">
    <div class="container">
      <a href={localizedPath('/journey', lang)} class="journey-card" data-reveal aria-label={t('home.journey.cta')}>
        <img src="/images/hero-astronaut.webp" alt="" role="presentation" width="1280" height="720" loading="lazy" />
        <div class="journey-card-overlay"></div>
        <div class="journey-card-content">
          <p class="eyebrow" style="margin:0 0 6px">{t('home.journey.eyebrow')}</p>
          <h2 class="journey-card-title">{t('home.journey.title', { n: journeyLen })}</h2>
          <span class="btn btn-primary journey-card-btn">{t('home.journey.cta')}</span>
        </div>
        <span class="hud-bracket tl"></span>
        <span class="hud-bracket br"></span>
      </a>
    </div>
  </section>

  <!-- ── ROADMAP ───────────────────────────────── -->
  <div id="roadmap">
    <Roadmap />
  </div>

  <!-- ── LATEST BLOG + TECH RADAR (sector: logs) ── -->
  <div data-sector="logs">
    {latestPosts.length > 0 && (
      <section style="padding-top:0">
        <div class="container">
          <div class="section-head" data-reveal>
            <div>
              <p class="eyebrow">{t('home.blog.eyebrow')}</p>
              <h2 class="section-title">{t('home.blog.title')}</h2>
            </div>
            <a href={localizedPath('/blog', lang)} class="mono see-all">{t('common.all')}</a>
          </div>
          <div class="grid grid-3" style="margin-top:24px">
            {latestPosts.map((p, i) => (
              <a
                href={localizedPath(`/blog/${p.slug}`, lang)}
                class="card blog-card"
                data-reveal
                style={`--reveal-delay:${i * 80}ms`}
              >
                <span class="mono muted" style="font-size:.78rem">{p.date}{p.readingTimeMin ? ` · ${t('common.readmin', { n: p.readingTimeMin })}` : ''}</span>
                <strong style="font-size:1.05rem;display:block;margin:6px 0 4px">{p.title}</strong>
                <span class="muted" style="font-size:.92rem">{p.excerpt}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {latestNews.length > 0 && (
      <section style="padding-top:0">
        <div class="container">
          <div class="section-head" data-reveal>
            <div>
              <p class="eyebrow">{t('home.news.eyebrow')}</p>
              <h2 class="section-title">{t('home.news.title')}</h2>
            </div>
            <a href={localizedPath('/news', lang)} class="mono see-all">{t('common.all')}</a>
          </div>
          <div class="news-grid" style="margin-top:24px">
            {latestNews.map((n, i) => (
              <article class="card news-card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <span class="mono muted news-date">{n.date}</span>
                <strong class="news-title">{n.title}</strong>
                <span class="muted news-summary">{n.summary}</span>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>

  <HomeIngress />
</Base>

<style>
  /* ── MANIFESTO ─────────────────────────── */
  .manifesto {
    padding: 52px 0 48px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid rgba(91,140,255,0.12);
    background: linear-gradient(180deg, rgba(8,12,28,0.0) 0%, rgba(8,12,28,0.45) 100%);
  }
  .manifesto-lines {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 18px;
  }
  .manifesto-lines li {
    display: flex; align-items: baseline; gap: 18px;
  }
  .mf-num {
    color: var(--accent); font-size: 0.72rem; letter-spacing: 2px;
    flex: 0 0 28px; opacity: 0.7;
  }
  .mf-text {
    font-size: clamp(1.05rem, 2.2vw, 1.4rem);
    font-weight: 600; letter-spacing: -0.02em; line-height: 1.3;
  }
  .grad-text {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── SOLVE CARDS ───────────────────────── */
  .solve-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 32px;
  }
  @media (max-width: 680px) { .solve-grid { grid-template-columns: 1fr; } }

  .solve-card {
    position: relative;
    padding: 28px 24px 24px 20px;
    /* border-box origin paints the 3px charge gradient strip into the transparent border area */
    background:
      linear-gradient(
        to top,
        var(--sc) calc(var(--charge, 0) * 100%),
        color-mix(in srgb, var(--sc) 18%, transparent) calc(var(--charge, 0) * 100%)
      ) 0 0 / 3px 100% no-repeat border-box border-box,
      rgba(12, 18, 40, 0.65);
    border: 1px solid var(--border);
    border-left: 3px solid transparent;
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow 0.3s var(--ease);
  }
  .solve-card:hover {
    box-shadow: 0 0 28px color-mix(in srgb, var(--sc) 18%, transparent), var(--shadow-lg);
  }
  .solve-ghost-num {
    position: absolute; top: -4px; right: 14px;
    font-size: 5rem; font-weight: 800; line-height: 1;
    color: var(--sc); opacity: 0.07; pointer-events: none; user-select: none;
    transition: opacity 0.3s;
  }
  .solve-card:hover .solve-ghost-num { opacity: 0.13; }
  .solve-body { position: relative; }
  .solve-problem {
    font-size: 1.1rem; font-weight: 700; margin: 0 0 10px;
    color: var(--text); max-width: 34ch; line-height: 1.3;
  }
  .solve-approach {
    color: var(--text-dim); font-size: 0.93rem; line-height: 1.6; margin: 0;
  }

  /* ── TECH DNA ──────────────────────────── */
  .dna-grid { display: grid; gap: 0; margin-top: 28px; }
  .dna-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    align-items: start;
  }
  .dna-row:last-child { border-bottom: none; }
  @media (max-width: 560px) {
    .dna-row { grid-template-columns: 1fr; gap: 8px; }
  }
  .dna-label {
    display: flex; align-items: center; gap: 8px; padding-top: 4px;
  }
  .dna-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--dc); flex: 0 0 auto;
    box-shadow: 0 0 6px var(--dc);
  }
  .dna-cat { font-size: 0.82rem; font-weight: 600; color: var(--dc); }
  .dna-count {
    font-size: 0.7rem; color: var(--text-mute);
    background: rgba(255,255,255,0.05); border-radius: 4px;
    padding: 1px 5px; margin-left: auto;
  }
  .dna-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .dna-chip { font-size: 0.8rem; }
  .dna-total {
    margin-top: 20px; font-size: 0.8rem; color: var(--accent-2);
    letter-spacing: 0.5px;
  }

  /* ── MISSION BAR ───────────────────────── */
  .mission-bar {
    padding: 28px 0;
    background: rgba(91,140,255,0.04);
    border-top: 1px solid rgba(91,140,255,0.15);
    border-bottom: 1px solid rgba(91,140,255,0.15);
    margin-bottom: 48px;
  }
  .mission-inner {
    display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
  }
  .mission-status {
    display: flex; align-items: center; gap: 10px; flex: 0 0 auto;
  }
  .mission-pulse {
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent-2);
    animation: missionPulse 2s ease-in-out infinite;
  }
  @keyframes missionPulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(54,214,195,0.5); }
    50% { box-shadow: 0 0 0 6px rgba(54,214,195,0); }
  }
  .mission-body {
    flex: 1; display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; min-width: 0;
  }
  .mission-label {
    font-weight: 700; font-size: 1.05rem; white-space: nowrap;
  }
  .mission-story { font-size: 0.92rem; color: var(--text-dim); }
  .mission-cta { flex: 0 0 auto; white-space: nowrap; }

  /* ── JOURNEY CARD ──────────────────────── */
  .journey-card {
    display: block; position: relative;
    border-radius: 20px; overflow: hidden;
    aspect-ratio: 21 / 8;
    border: 1px solid var(--border);
    text-decoration: none; color: inherit;
    transition: border-color 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .journey-card:hover {
    border-color: rgba(91,140,255,0.4);
    box-shadow: 0 0 60px rgba(91,140,255,0.2), var(--shadow-lg);
  }
  .journey-card img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: 32% center;
    transition: transform 0.6s var(--ease);
  }
  .journey-card:hover img { transform: scale(1.03); }
  .journey-card-overlay {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(4,6,14,0.85) 0%, rgba(4,6,14,0.3) 55%, rgba(4,6,14,0.1) 100%),
      linear-gradient(180deg, rgba(4,6,14,0.2) 0%, rgba(4,6,14,0.1) 50%, rgba(4,6,14,0.6) 100%);
  }
  .journey-card-content {
    position: relative; z-index: 2;
    padding: clamp(24px, 4vw, 48px);
    height: 100%; display: flex; flex-direction: column; justify-content: flex-end;
  }
  .journey-card-title {
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    font-weight: 700; letter-spacing: -0.03em; margin: 0 0 18px;
    line-height: 1.1;
  }
  .journey-card-btn { pointer-events: none; align-self: flex-start; }

  /* HUD brackets */
  .hud-bracket { position: absolute; width: 22px; height: 22px; pointer-events: none; z-index: 3; opacity: 0.7; }
  .hud-bracket.tl { top: 14px; left: 14px; border-top: 2px solid var(--accent); border-left: 2px solid var(--accent); }
  .hud-bracket.br { bottom: 14px; right: 14px; border-bottom: 2px solid var(--accent-2); border-right: 2px solid var(--accent-2); }

  /* ── SHARED UTILS ──────────────────────── */
  .section-head {
    display: flex; justify-content: space-between; align-items: baseline;
    flex-wrap: wrap; gap: 8px;
  }
  .see-all { font-size: .9rem; color: var(--text-dim); text-decoration: none; }
  .see-all:hover { color: var(--accent-2); }

  .blog-card { text-decoration: none; color: inherit; display: grid; gap: 4px; transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease); }
  .blog-card:hover { border-color: rgba(91,140,255,0.35); box-shadow: 0 0 22px rgba(91,140,255,0.1); }

  .news-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (max-width: 600px) { .news-grid { grid-template-columns: 1fr; } }
  .news-card { display: grid; gap: 5px; }
  .news-date { font-size: .76rem; }
  .news-title { font-size: 1rem; }
  .news-summary { font-size: .9rem; }
</style>
