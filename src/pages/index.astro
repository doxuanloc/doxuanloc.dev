---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HomeIngress from '../components/home/HomeIngress.astro';
import WelcomeOverlay from '../components/home/WelcomeOverlay.astro';
import { getProfile, getAllPosts, getAllNews } from '../lib/content';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfile(lang);
const latestPosts = getAllPosts().slice(0, 3);
const latestNews = getAllNews().slice(0, 4);
const skills = profile.skills as Record<string, string[]>;
const solves: any[] = profile.solves ?? [];
const journeyLen = (profile.journey ?? []).length;
const currentFocus = (profile.roadmap ?? []).find((r: any) => r.status === 'in-progress');

const solveAccents = ['#e0704d', '#ebb36b', '#7d8e7c', '#f0b232'];

const skillGroups = [
  { label: 'Frontend',     key: 'frontend',    c: '#ebb36b' },
  { label: 'Backend',      key: 'backend',     c: '#e0704d' },
  { label: 'Cloud/DevOps', key: 'cloud_devops',c: '#7d8e7c' },
  { label: 'AI / ML',      key: 'ai_ml',       c: '#f0b232' },
  { label: 'Practices',    key: 'practices',   c: '#ff7eb3' },
];
const totalSkills = Object.values(skills).flat().length;
const totalGroups = skillGroups.filter(g => (skills[g.key] ?? []).length > 0).length;

// Constellation Core — precompute hub positions (server-side, no trig in browser)
const CONST_R = 130; const CONST_CX = 190; const CONST_CY = 190;
const activeHubs = skillGroups.filter(g => (skills[g.key] ?? []).length > 0).map((g, i, arr) => {
  const angle = (Math.PI * 2 / arr.length) * i - Math.PI / 2;
  return {
    ...g,
    count: (skills[g.key] ?? []).length,
    hx: CONST_CX + CONST_R * Math.cos(angle),
    hy: CONST_CY + CONST_R * Math.sin(angle),
    hi: i,
  };
});
---
<Base>
  <Hero />

  <!-- ── MANIFESTO ─────────────────────────────── -->
  <div class="manifesto" data-reveal>
    <div class="container">
      <ul class="manifesto-lines" role="list">
        <li><span class="mf-num mono">01</span><span class="mf-text grad-text">{t('home.manifesto.l1')}</span></li>
        <li><span class="mf-num mono">02</span><span class="mf-text">{t('home.manifesto.l2')}</span></li>
        <li><span class="mf-num mono">03</span><span class="mf-text muted">{t('home.manifesto.l3')}</span></li>
      </ul>
    </div>
  </div>

  <!-- ── PROBLEMS I SOLVE ──────────────────────── -->
  <section class="section-solve">
    <div class="container">
      <p class="eyebrow" data-reveal>{t('home.solve.eyebrow')}</p>
      <h2 class="section-title" data-reveal style="--reveal-delay:60ms">{t('home.solve.title')}</h2>
      <p class="section-sub" data-reveal style="--reveal-delay:100ms">{t('home.solve.sub')}</p>
      <div class="solve-ledger">
        {solves.map((s, i) => (
          <div
            class="solve-strip"
            data-reveal
            data-tilt
            data-chargeable
            style={`--reveal-delay:${i * 80 + 120}ms; --sc:${solveAccents[i % solveAccents.length]}; --charge: var(--solve-charge-${i})`}
          >
            <div class="solve-rail">
              <span class="solve-num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="solve-charge-bar" aria-hidden="true"></span>
            </div>
            <div class="solve-problem-zone">
              <h3 class="solve-problem">{s.problem}</h3>
            </div>
            <div class="solve-reason-zone">
              <p class="solve-decision"><span class="solve-decision-marker" aria-hidden="true">▸</span>{s.decision ?? s.approach}</p>
              {s.detail && <p class="solve-detail">{s.detail}</p>}
              {s.outcome && <p class="solve-outcome mono" aria-label="outcome">&gt;&gt; {s.outcome}</p>}
              <div class="chips solve-chips">
                {(s.stack ?? []).map((tag: string) => (
                  <span class="chip" style={`border-color:color-mix(in srgb,${solveAccents[i % solveAccents.length]} 35%,var(--border));color:${solveAccents[i % solveAccents.length]}`}>{tag}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TECH DNA — CONSTELLATION CORE ───────────── -->
  <section class="section-skills" style="padding-top:0">
    <div class="container">
      <p class="eyebrow" data-reveal>{t('home.skills.eyebrow')}</p>
      <h2 class="section-title" data-reveal style="--reveal-delay:60ms">{t('home.skills.title')}</h2>
      <p class="section-sub" data-reveal style="--reveal-delay:100ms">{t('home.skills.sub')}</p>

      <div class="const-display">
        <!-- Left col: Constellation visual -->
        <div class="const-visual-col">
          <!-- Desktop circular constellation -->
          <div class="constellation-wrap" data-reveal style="--reveal-delay:120ms">
            <div class="constellation-core" aria-hidden="true">
              <!-- Orbital background rings -->
              <div class="const-orbit const-orbit-1"></div>
              <div class="const-orbit const-orbit-2"></div>

              <!-- SVG filaments (center-to-hub + adjacent hub connections) -->
              <svg class="const-svg" viewBox="0 0 380 380" aria-hidden="true">
                {/* Lines from center to each hub */}
                {activeHubs.map((h) => (
                  <line
                    x1={CONST_CX} y1={CONST_CY}
                    x2={h.hx.toFixed(1)} y2={h.hy.toFixed(1)}
                    stroke={h.c} stroke-width="1" stroke-opacity="0.2"
                    class="const-filament" style={`--fi:${h.hi}`}
                    pathLength="1" stroke-dasharray="1" stroke-dashoffset="1"
                  />
                ))}
                {/* Adjacent hub ring */}
                {activeHubs.map((h, i) => {
                  const next = activeHubs[(i + 1) % activeHubs.length];
                  return (
                    <line
                      x1={h.hx.toFixed(1)} y1={h.hy.toFixed(1)}
                      x2={next.hx.toFixed(1)} y2={next.hy.toFixed(1)}
                      stroke={h.c} stroke-width="0.5" stroke-opacity="0.12"
                      class="const-filament" style={`--fi:${activeHubs.length + i}`}
                      pathLength="1" stroke-dasharray="1" stroke-dashoffset="1"
                    />
                  );
                })}
              </svg>

              <!-- Center node -->
              <div class="const-center">
                <span class="const-count">{totalSkills}</span>
                <span class="const-unit mono">NODES</span>
              </div>

              <!-- Domain hubs -->
              {activeHubs.map((h) => (
                <div
                  class="const-hub"
                  style={`left:${h.hx.toFixed(1)}px;top:${h.hy.toFixed(1)}px;--hc:${h.c};--hi:${h.hi}`}
                >
                  <div class="hub-inner">
                    <div class="hub-orb">
                      <span class="hub-count">{h.count}</span>
                    </div>
                    <span class="hub-label">{h.label}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Mobile compact hub grid -->
          <div class="const-hub-grid" aria-hidden="true">
            {activeHubs.map(h => (
              <div class="hub-grid-item" data-reveal style={`--hc:${h.c};--reveal-delay:${h.hi * 60}ms`}>
                <span class="hub-grid-orb"></span>
                <span class="hub-grid-label">{h.label}</span>
                <span class="hub-grid-count mono">{h.count}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Right col: skill rows -->
        <div class="const-rows-col">
          <div class="dna-grid">
            {activeHubs.map((h, i) => (
              <div class="dna-row" data-reveal style={`--reveal-delay:${i * 70 + 120}ms; --dc:${h.c}`}>
                <div class="dna-label">
                  <span class="dna-dot"></span>
                  <span class="dna-cat">{h.label}</span>
                  <span class="dna-count mono">{h.count}</span>
                </div>
                <div class="dna-chips">
                  {(skills[h.key] ?? []).map((s: string) => <span class="chip dna-chip">{s}</span>)}
                </div>
              </div>
            ))}
          </div>
          <p class="dna-total mono" data-reveal>
            {t('home.skills.total', { n: totalSkills, g: totalGroups })}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CURRENT MISSION ───────────────────────── -->
  {currentFocus && (
    <div class="mission-bar" data-reveal>
      <div class="container">
        <div class="mission-inner">
          <div class="mission-status">
            <span class="mission-pulse"></span>
            <span class="eyebrow" style="margin:0">{t('home.focus.eyebrow')}</span>
          </div>
          <div class="mission-body">
            <span class="mission-label grad-text">{currentFocus.label}</span>
            <span class="mission-story muted">{currentFocus.story}</span>
          </div>
          <a href={localizedPath('/journey', lang)} class="btn btn-ghost mission-cta">{t('home.focus.cta')}</a>
        </div>
      </div>
    </div>
  )}

  <!-- ── JOURNEY TEASER ────────────────────────── -->
  <section class="section-journey-teaser" style="padding-top:0">
    <div class="container">
      <a href={localizedPath('/journey', lang)} class="journey-card" data-reveal aria-label={t('home.journey.cta')}>
        <img src="/images/hero-astronaut.webp" alt="" role="presentation" width="1280" height="720" loading="lazy" />
        <div class="journey-card-overlay"></div>
        <div class="journey-card-content">
          <p class="eyebrow" style="margin:0 0 6px">{t('home.journey.eyebrow')}</p>
          <h2 class="journey-card-title">{t('home.journey.title', { n: journeyLen })}</h2>
          <span class="btn btn-primary journey-card-btn">{t('home.journey.cta')}</span>
        </div>
        <span class="hud-bracket tl"></span>
        <span class="hud-bracket br"></span>
      </a>
    </div>
  </section>

  <!-- ── LATEST BLOG + TECH RADAR (sector: logs) ── -->
  <div data-sector="logs">
    {latestPosts.length > 0 && (
      <section style="padding-top:0">
        <div class="container">
          <div class="section-head" data-reveal>
            <div>
              <p class="eyebrow">{t('home.blog.eyebrow')}</p>
              <h2 class="section-title">{t('home.blog.title')}</h2>
            </div>
            <a href={localizedPath('/blog', lang)} class="mono see-all">{t('common.all')}</a>
          </div>
          <div class="grid grid-3" style="margin-top:24px">
            {latestPosts.map((p, i) => (
              <a
                href={localizedPath(`/blog/${p.slug}`, lang)}
                class="card blog-card"
                data-reveal
                style={`--reveal-delay:${i * 80}ms`}
              >
                <span class="mono muted" style="font-size:.78rem">{p.date}{p.readingTimeMin ? ` · ${t('common.readmin', { n: p.readingTimeMin })}` : ''}</span>
                <strong style="font-size:1.05rem;display:block;margin:6px 0 4px">{p.title}</strong>
                <span class="muted" style="font-size:.92rem">{p.excerpt}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {latestNews.length > 0 && (
      <section style="padding-top:0">
        <div class="container">
          <div class="section-head" data-reveal>
            <div>
              <p class="eyebrow">{t('home.news.eyebrow')}</p>
              <h2 class="section-title">{t('home.news.title')}</h2>
            </div>
            <a href={localizedPath('/news', lang)} class="mono see-all">{t('common.all')}</a>
          </div>
          <div class="news-grid" style="margin-top:24px">
            {latestNews.map((n, i) => (
              <article class="card news-card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <span class="mono muted news-date">{n.date}</span>
                <strong class="news-title">{n.title}</strong>
                <span class="muted news-summary">{n.summary}</span>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>

  <HomeIngress />
  <WelcomeOverlay />
</Base>

<style>
  /* ── MANIFESTO (Primary Directives) ────── */
  .manifesto {
    padding: 72px 0 68px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid rgba(224,112,77,0.15);
    background:
      linear-gradient(180deg, rgba(8,12,28,0.0) 0%, rgba(8,12,28,0.5) 100%),
      radial-gradient(ellipse 60% 80% at 50% 50%, rgba(224,112,77,0.04) 0%, transparent 70%);
  }
  .manifesto-lines {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 0;
    max-width: 680px;
  }
  .manifesto-lines li {
    display: flex; align-items: baseline; gap: 20px;
    position: relative;
    padding: 18px 0;
    transform: translateX(-10px);
    transition: transform 0.55s cubic-bezier(0.16,1,0.3,1);
  }
  .manifesto.in .manifesto-lines li:nth-child(1) { transform: none; transition-delay: 50ms; }
  .manifesto.in .manifesto-lines li:nth-child(2) { transform: none; transition-delay: 160ms; }
  .manifesto.in .manifesto-lines li:nth-child(3) { transform: none; transition-delay: 270ms; }
  /* Connector filaments stagger after their line */
  .manifesto.in .manifesto-lines li:nth-child(1):not(:last-child)::after { transition-delay: 280ms; }
  .manifesto.in .manifesto-lines li:nth-child(2):not(:last-child)::after { transition-delay: 400ms; }
  /* Filament connector drawn between lines on reveal */
  .manifesto-lines li:not(:last-child)::after {
    content: '';
    position: absolute;
    bottom: 0; left: 13px;
    width: 1px; height: 100%;
    background: linear-gradient(to bottom,
      color-mix(in srgb, var(--accent) 25%, transparent) 0%,
      color-mix(in srgb, var(--accent-2) 15%, transparent) 100%
    );
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.9s var(--ease, ease) 0.5s;
  }
  .manifesto.in .manifesto-lines li:not(:last-child)::after {
    transform: scaleY(1);
  }
  .mf-num {
    color: var(--accent); font-size: 0.7rem; letter-spacing: 2px;
    flex: 0 0 28px; opacity: 0.6;
    font-family: 'JetBrains Mono', monospace;
  }
  .mf-text {
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    font-weight: 600; letter-spacing: -0.025em; line-height: 1.25;
    transition: opacity 0.3s ease;
  }
  /* First directive — strongest signal */
  .manifesto-lines li:first-child .mf-text {
    font-size: clamp(1.2rem, 2.8vw, 1.7rem);
    font-weight: 700;
  }
  .manifesto-lines li:last-child .mf-text {
    opacity: 0.6;
  }
  .grad-text {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  @media (prefers-reduced-motion: reduce) {
    .manifesto-lines li { transform: none; transition: none; }
    .manifesto-lines li:not(:last-child)::after { transition: none; transform: scaleY(1); }
  }

  /* ── SOLVE LEDGER (Telemetry Dossier) ───── */
  .solve-ledger {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 32px;
  }

  .solve-strip {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 38%) minmax(0, 1fr);
    gap: 0 28px;
    padding: 26px 28px 24px 0;
    background: color-mix(in srgb, var(--bg-card) 72%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .solve-strip:hover {
    border-color: color-mix(in srgb, var(--sc) 35%, var(--border));
    box-shadow: 0 0 28px color-mix(in srgb, var(--sc) 14%, transparent), var(--shadow);
  }
  .solve-strip:hover .chip {
    border-color: color-mix(in srgb, var(--sc) 55%, var(--border)) !important;
  }

  .solve-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-top: 2px;
  }
  .solve-num {
    font-size: 0.85rem; font-weight: 700;
    color: var(--sc); opacity: 0.85;
  }
  .solve-charge-bar {
    flex: 1; width: 3px; border-radius: 2px;
    background: linear-gradient(
      to top,
      var(--sc) calc(var(--charge, 0) * 100%),
      color-mix(in srgb, var(--sc) 18%, transparent) calc(var(--charge, 0) * 100%)
    );
    transition: background 0.2s linear;
  }
  .solve-strip:hover .solve-charge-bar {
    background: var(--sc);
    box-shadow: 0 0 10px color-mix(in srgb, var(--sc) 45%, transparent);
  }

  .solve-problem-zone {
    border-right: 1px solid var(--border-soft);
    padding-right: 24px;
  }
  .solve-problem {
    font-size: 1.18rem; font-weight: 700; margin: 0;
    color: var(--text); max-width: 40ch; line-height: 1.32;
  }

  .solve-reason-zone { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .solve-decision {
    margin: 0;
    font-size: 0.97rem; font-weight: 600; line-height: 1.5;
    color: color-mix(in srgb, var(--sc) 72%, var(--text));
  }
  .solve-decision-marker {
    color: var(--sc);
    margin-right: 8px;
    transition: text-shadow 0.3s;
  }
  .solve-strip:hover .solve-decision-marker {
    text-shadow: 0 0 8px var(--sc);
  }
  .solve-detail {
    margin: 0;
    color: var(--text-dim); font-size: 0.92rem; line-height: 1.6;
    max-width: 72ch;
  }
  .solve-outcome {
    margin: 0;
    font-size: 0.78rem; letter-spacing: 0.04em;
    color: var(--accent-3);
    opacity: 0.9;
  }
  .solve-chips { margin-top: 2px; }

  @media (max-width: 680px) {
    .solve-strip {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 22px 18px 20px;
    }
    .solve-rail {
      flex-direction: row;
      align-items: center;
      padding-top: 0;
    }
    .solve-charge-bar {
      width: auto; height: 3px; flex: 1;
      background: linear-gradient(
        to right,
        var(--sc) calc(var(--charge, 0) * 100%),
        color-mix(in srgb, var(--sc) 18%, transparent) calc(var(--charge, 0) * 100%)
      );
    }
    .solve-problem-zone { border-right: none; padding-right: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .solve-charge-bar { background: var(--sc) !important; box-shadow: none !important; }
    .solve-strip, .solve-decision-marker { transition: none; }
  }

  /* ── CONSTELLATION CORE ───────────────── */
  .const-display {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 48px;
    align-items: start;
    margin-top: 40px;
  }
  @media (max-width: 960px) {
    .const-display { grid-template-columns: 1fr; gap: 32px; }
  }

  /* Desktop: sticky visual col */
  .const-visual-col {
    position: sticky;
    top: 84px;
  }
  @media (max-width: 960px) {
    .const-visual-col { position: static; }
  }

  /* Circular constellation (desktop only) */
  .constellation-wrap {
    display: flex;
    justify-content: center;
  }
  @media (max-width: 960px) {
    .constellation-wrap { display: none; }
  }

  .constellation-core {
    position: relative;
    width: 380px; height: 380px;
    flex-shrink: 0;
  }

  /* Orbital background rings */
  .const-orbit {
    position: absolute;
    left: 50%; top: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    border: 1px dashed rgba(224,112,77,0.1);
  }
  .const-orbit-1 { width: 270px; height: 270px; }
  .const-orbit-2 {
    width: 368px; height: 368px;
    border-color: rgba(235,179,107,0.06);
    border-style: solid;
    animation: constRingSpin 60s linear infinite;
  }
  @keyframes constRingSpin {
    to { transform: translate(-50%,-50%) rotate(360deg); }
  }

  /* SVG filaments */
  .const-svg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    pointer-events: none; overflow: visible;
  }
  .const-filament {
    stroke-dasharray: 500;
    stroke-dashoffset: 500;
    transition: stroke-dashoffset 0.9s ease calc(var(--fi, 0) * 0.12s + 0.3s);
  }
  .constellation-wrap.in .const-filament {
    stroke-dashoffset: 0;
  }

  /* Center node */
  .const-center {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    text-align: center;
  }
  .const-center::after {
    content: '';
    position: absolute; left: 50%; top: 50%;
    width: 40px; height: 40px; border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--accent-2) 55%, transparent);
    transform: translate(-50%, -50%) scale(0.5);
    opacity: 0; pointer-events: none;
  }
  .constellation-wrap.in .const-center::after {
    animation: constHubPing 0.65s ease-out 0.25s both;
  }
  @keyframes constHubPing {
    from { transform: translate(-50%,-50%) scale(0.5); opacity: 0.9; }
    to   { transform: translate(-50%,-50%) scale(3); opacity: 0; }
  }
  .const-count {
    font-family: 'Tektur', sans-serif;
    font-size: 2rem; font-weight: 700; line-height: 1;
    color: var(--accent-2);
    text-shadow: 0 0 24px color-mix(in srgb, var(--accent-2) 45%, transparent);
  }
  .const-unit {
    font-size: 0.55rem; letter-spacing: 2.5px; color: var(--text-mute);
  }

  /* Domain hubs */
  .const-hub {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 84px; text-align: center;
  }
  .hub-inner {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    animation: hubFloat 8s ease-in-out infinite;
    animation-delay: calc(var(--hi, 0) * 1.5s);
  }
  .hub-orb {
    position: relative;
    width: 52px; height: 52px; border-radius: 50%;
    background: color-mix(in srgb, var(--hc) 10%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--hc) 45%, transparent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--hc) 20%, transparent);
