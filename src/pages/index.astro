---
import Base from '../layouts/Base.astro';
import SystemVisual from '../components/SystemVisual.astro';
import HeroScene from '../components/HeroScene.astro';
import XemPreview from '../components/XemPreview.astro';
import { getProfile, getAllPosts, getPostNativeLocales } from '../lib/content';
import { getPortfolioCopy } from '../lib/portfolio';
import { getLangFromUrl, localizedPath } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const profile = getProfile(lang);
const copy = getPortfolioCopy(lang);
const posts = getAllPosts(lang).filter(post => getPostNativeLocales(post.slug).includes(lang)).slice(0, 3);
const career = (profile.experience ?? []).slice(0, 2);
const lensLabels = { en: ['Systems', 'Intelligence', 'Trust'], vi: ['Hệ thống', 'Trí tuệ', 'Tin cậy'], ja: ['システム', 'AI', '信頼'] }[lang];
const lensText = { en: ['Interface, infrastructure, and the decisions in between.', 'Models evaluated in the workflow they serve.', 'Actions that can be inspected. Decisions that can be explained.'], vi: ['Giao diện, hạ tầng và những quyết định kết nối chúng.', 'Đánh giá mô hình trong chính luồng công việc nó phục vụ.', 'Hành động có thể đối chiếu. Quyết định có thể giải thích.'], ja: ['インターフェース、基盤、その間をつなぐ設計判断。', 'モデルを、実際に使う業務フローの中で評価。', '確認できる操作。説明できる判断。'] }[lang];
const allWriting = { en: 'All writing', vi: 'Tất cả bài viết', ja: 'すべての記事' }[lang];
const projectLabel = { en: 'View project details', vi: 'Xem chi tiết dự án', ja: 'プロジェクト詳細を見る' }[lang];
---
<Base description={copy.hero.summary} animatedBg={false}>
  <section class="hero-editorial container" aria-labelledby="hero-title">
    <div class="hero-topline mono"><span>{copy.hero.eyebrow}</span><span class="edition">PORTFOLIO / 2026</span></div>
    <div class="hero-layout">
      <div class="hero-copy">
        <p class="hero-role">{profile.identity.title}</p>
        <h1 id="hero-title">{copy.hero.title}<span>{copy.hero.line2}</span></h1>
        <p class="hero-summary">{copy.hero.summary}</p>
        <div class="hero-actions"><a class="btn btn-primary" href="#selected-work">{copy.hero.primary}<span aria-hidden="true">↗</span></a><a class="hero-contact" href={`mailto:${profile.identity.email}`}>{copy.hero.secondary}<span aria-hidden="true">↗</span></a></div>
        <div class="hero-location"><span aria-hidden="true" class="location-dot"></span>{copy.hero.location}</div>
      </div>
      <div class="hero-art" data-lens="0">
        <HeroScene lang={lang} />
        <div class="lens-tabs" role="tablist" aria-label={lang === 'vi' ? 'Góc nhìn kỹ thuật' : lang === 'ja' ? '技術の視点' : 'Engineering perspectives'}>
          {lensLabels.map((label, i) => <button type="button" role="tab" id={`lens-tab-${i}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`lens-panel-${i}`} tabindex={i === 0 ? 0 : -1} data-lens-index={i}>{label}</button>)}
        </div>
        {lensText.map((text, i) => <p class="lens-caption" role="tabpanel" id={`lens-panel-${i}`} aria-labelledby={`lens-tab-${i}`} hidden={i !== 0}>{text}</p>)}
      </div>
    </div>
    <div class="hero-baseline"><span class="mono">FULL-STACK / AI / SECURITY</span><a href="#selected-work"><span>{copy.sections.workEyebrow}</span><span aria-hidden="true">↓</span></a></div>
  </section>

  <section class="work-section container" id="selected-work" aria-labelledby="work-title">
    <div class="section-kicker"><span class="mono">01 / {copy.sections.workEyebrow}</span><span class="kicker-line"></span></div>
    <div class="section-heading"><h2 id="work-title">{copy.sections.workTitle}</h2><p>{copy.sections.workSummary}</p></div>
    <div class="work-grid">
      {copy.selectedWork.map((work, i) => (
        <article class:list={['work-card', i === 0 && 'work-featured']}>
          {work.id === 'agent-tooling' ? <XemPreview lang={lang} /> : <a class="work-visual-link" href={work.href} aria-label={`${projectLabel}: ${work.title}`}><SystemVisual kind={work.visual} lang={lang} /><span class="visual-arrow" aria-hidden="true">↗</span></a>}
          <div class="work-copy">
            <div class="work-meta mono"><span>{work.category}</span><span>0{i + 1}</span></div>
            <h3><a href={work.href}>{work.title}</a></h3>
            <p class="work-summary">{work.summary}</p>
            <div class="work-decision"><span class="mono">{copy.sections.approach}</span><p>{work.approach}</p></div>
            <div class="work-stack">{work.stack.map(item => <span>{item}</span>)}</div>
            <a class="text-link" href={work.href}>{copy.sections.projectCta}<span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="experience-preview container" aria-labelledby="experience-title">
    <div class="section-kicker"><span class="mono">02 / {copy.sections.experienceEyebrow}</span><span class="kicker-line"></span></div>
    <div class="experience-layout">
      <div class="experience-intro"><h2 id="experience-title">{copy.sections.experienceTitle}</h2><p>{copy.sections.experienceSummary}</p><a class="text-link" href={localizedPath('/experience', lang)}>{copy.sections.viewAll}<span aria-hidden="true">↗</span></a></div>
      <div class="career-preview">
        {career.map((role: any) => <a class="career-row" href={localizedPath('/experience', lang)}><span class="career-marker" aria-hidden="true"></span><div><span class="career-period mono">{role.start} — {copy.experience.present}</span><h3>{role.company}</h3><p>{role.role}</p></div><span class="career-arrow" aria-hidden="true">↗</span></a>)}
        <a class="journey-link" href={localizedPath('/journey', lang)}>{lang === 'vi' ? 'Khám phá hành trình' : lang === 'ja' ? 'これまでの歩み' : 'The story so far'}<span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="focus-header"><p class="mono">{copy.experience.focusLabel}</p><a href={localizedPath('/experience', lang)} aria-label={copy.sections.viewAll}>↗</a></div>
    <div class="focus-grid">{copy.recentFocus.map((focus, i) => <div class="focus-card"><span class="focus-index mono">0{i + 1}</span><h3>{focus.title}</h3><p>{focus.description}</p></div>)}</div>
  </section>

  {posts.length > 0 && <section class="writing-section container" aria-labelledby="writing-title">
    <div class="section-kicker"><span class="mono">03 / {copy.sections.writingEyebrow}</span><span class="kicker-line"></span></div>
    <div class="section-heading"><h2 id="writing-title">{copy.sections.writingTitle}</h2><a class="text-link" href={localizedPath('/blog', lang)}>{allWriting}<span aria-hidden="true">↗</span></a></div>
    <div class="writing-grid">{posts.map(post => <a class="writing-card" href={localizedPath(`/blog/${post.slug}`, lang)}>{post.coverImage && <div class="writing-image"><img src={post.coverImage} alt="" loading="lazy" width="640" height="360" /></div>}<div class="writing-copy"><span class="mono writing-date">{post.date}</span><h3>{post.title}</h3><span class="writing-arrow" aria-hidden="true">↗</span></div></a>)}</div>
  </section>}

  <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="container contact-layout"><div><p class="eyebrow">{copy.sections.contactEyebrow}</p><h2 id="contact-title">{copy.sections.contactTitle}</h2><p class="contact-summary">{copy.sections.contactSummary}</p><a class="btn btn-primary" href={`mailto:${profile.identity.email}`}>{copy.sections.contactCta}<span aria-hidden="true">↗</span></a></div><div class="contact-aside"><img src="/images/avatar.png" alt={profile.identity.name} width="80" height="80" loading="lazy" /><p>{profile.identity.name}</p><a href={`mailto:${profile.identity.email}`}>{profile.identity.email}</a><div><a href={profile.identity.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={profile.identity.links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></div></div></section>
</Base>

<script>
  import { initPortfolioMotion } from '../scripts/portfolio-motion';
  function setupLenses() {
    const art = document.querySelector<HTMLElement>('.hero-art');
    if (!art || art.dataset.ready) return;
    art.dataset.ready = 'true';
    const tabs = [...art.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...art.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    function select(index: number, focus = false) {
      art!.dataset.lens = String(index);
      tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
      panels.forEach((panel, i) => panel.hidden = i !== index);
      if (focus) tabs[index].focus();
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', event => {
        const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : event.key === 'ArrowLeft' ? (index + tabs.length - 1) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : null;
        if (next !== null) { event.preventDefault(); select(next, true); }
      });
    });
  }
  document.addEventListener('astro:page-load', () => { setupLenses(); initPortfolioMotion(); });
</script>

<style>
  .hero-editorial { padding-top: 32px; padding-bottom: 0; }
  .hero-topline { display: flex; justify-content: space-between; gap: 20px; font-size: .75rem; color: var(--text-mute); letter-spacing: .08em; }
  .edition { color: var(--text-dim); }
  .hero-layout { display: grid; grid-template-columns: 1.25fr 1fr; gap: 20px; align-items: center; min-height: 580px; padding: 35px 0 30px; }
  .hero-role { color: var(--text-dim); font-size: .8rem; margin: 0 0 24px; }
  h1 { font-size: clamp(2.7rem, 5.4vw, 4.7rem); font-weight: 500; line-height: 1.08; letter-spacing: -.072em; margin: 0 0 28px; }
  h1 span { display: block; color: var(--accent); font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-weight: 400; letter-spacing: -.065em; line-height: 1.18; }
  :global(html[lang="ja"]) h1 { font-size: clamp(2.3rem, 4.2vw, 3.4rem); line-height: 1.3; letter-spacing: -.04em; }
  :global(html[lang="ja"]) h1 span { font-family: var(--font); font-style: normal; letter-spacing: -.04em; }
  .hero-summary { font-size: 1rem; color: var(--text-dim); max-width: 43ch; line-height: 1.85; margin: 0 0 30px; }
  .hero-actions { display: flex; align-items: center; gap: 25px; flex-wrap: wrap; }
  .hero-contact { min-height: 48px; display: inline-flex; align-items: center; gap: 14px; color: var(--text); font-size: .85rem; }
  .hero-contact:hover { color: var(--accent); }
  .hero-location { display: flex; align-items: center; gap: 9px; color: var(--text-mute); font-size: .75rem; margin-top: 32px; }
  .location-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent-3); flex-shrink: 0; }
  .hero-art { min-width: 0; position: relative; }
  .lens-tabs { display: flex; gap: 3px; justify-content: center; margin-top: -3px; }
  .lens-tabs button { min-height: 40px; border: 1px solid transparent; background: none; color: var(--text-mute); padding: 8px 14px; cursor: pointer; border-radius: 7px; font-size: .8rem; }
  .lens-tabs button[aria-selected="true"] { color: var(--text); background: #202733; border-color: #3a475c; }
  .lens-caption { min-height: 42px; text-align: center; font-size: .8rem; color: var(--text-mute); margin: 9px auto 0; max-width: 35ch; }
  .hero-art[data-lens="1"] :global(.art-core) { filter: hue-rotate(30deg); }
  .hero-art[data-lens="2"] :global(.art-core) { filter: hue-rotate(-35deg); }
  .hero-baseline { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-soft); padding: 20px 0; }
  .hero-baseline > span { font-size: .72rem; letter-spacing: .12em; color: var(--text-mute); }
  .hero-baseline a { font-size: .8rem; color: var(--text-dim); display: flex; align-items: center; gap: 22px; }
  .work-section, .experience-preview, .writing-section { padding-top: 88px; padding-bottom: 0; }
  .section-kicker { display: flex; align-items: center; gap: 28px; margin-bottom: 30px; font-size: .75rem; color: var(--text-mute); text-transform: uppercase; letter-spacing: .1em; }
  .kicker-line { height: 1px; flex: 1; background: var(--border-soft); }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 50px; margin-bottom: 32px; }
  h2 { font-size: clamp(1.8rem, 3.6vw, 3rem); font-weight: 500; line-height: 1.15; letter-spacing: -.065em; margin: 0; }
  .section-heading h2 { max-width: 15ch; }
  .section-heading p { max-width: 40ch; margin: 0; font-size: .88rem; color: var(--text-dim); }
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .work-card { border: 1px solid var(--border-soft); border-radius: 14px; overflow: hidden; background: #181b20; min-width: 0; transition: border-color .25s; }
  .work-card:hover { border-color: #596c88; }
  .work-featured { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1.1fr; }
  .work-visual-link { display: block; position: relative; color: inherit; overflow: hidden; }
  .work-visual-link :global(.system-art) { height: 100%; }
  .work-featured .work-visual-link :global(.system-art) { min-height: 450px; }
  .work-featured .work-visual-link :global(.orbit-art) { height: 380px; }
  .visual-arrow { position: absolute; top: 20px; right: 20px; display: grid; place-items: center; width: 35px; height: 35px; border: 1px solid #3b4b63; border-radius: 50%; color: #c7dcff; transition: background .25s; }
  .work-visual-link:hover .visual-arrow { background: #2d4263; }
  .work-copy { padding: 32px; }
  .work-featured .work-copy { padding: 40px; display: flex; flex-direction: column; justify-content: center; }
  .work-meta { font-size: .75rem; letter-spacing: .04em; color: var(--text-mute); display: flex; justify-content: space-between; gap: 20px; }
  .work-copy h3 { font-size: 1.9rem; font-weight: 500; letter-spacing: -.05em; line-height: 1.2; margin: 19px 0 14px; max-width: 20ch; }
  .work-copy h3 a { color: var(--text); }.work-copy h3 a:hover { color: var(--accent); }
  .work-summary { color: var(--text-dim); font-size: .86rem; margin: 0 0 25px; }
  .work-decision { border-left: 1px solid #6689bf; padding-left: 15px; margin-bottom: 25px; }
  .work-decision span { text-transform: uppercase; font-size: .72rem; letter-spacing: .08em; color: var(--accent); }
  .work-decision p { font-size: .78rem; color: var(--text-dim); margin: 6px 0 0; }
  .work-stack { display: flex; flex-wrap: wrap; gap: 8px 17px; margin-bottom: 25px; font-size: .75rem; color: #a2b6d5; }
  .text-link { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; color: var(--text); font-size: .8rem; min-height: 44px; width: fit-content; border-bottom: 1px solid #62718a; }
  .text-link:hover { color: var(--accent); border-color: var(--accent); }
  .experience-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; padding-top: 8px; }
  .experience-intro h2 { max-width: 12ch; }.experience-intro p { color: var(--text-dim); max-width: 39ch; font-size: .88rem; margin: 25px 0; }
  .career-row { display: flex; gap: 23px; position: relative; padding: 0 0 25px; color: inherit; }
  .career-row + .career-row { padding-top: 15px; border-top: 1px solid var(--border-soft); }
  .career-marker { width: 8px; height: 8px; border: 1px solid #809bc4; border-radius: 50%; margin-top: 12px; flex-shrink: 0; }
  .career-period { color: var(--text-mute); font-size: .75rem; }.career-row h3 { font-size: 1.1rem; font-weight: 500; margin: 8px 0; }.career-row p { font-size: .76rem; color: var(--text-dim); margin: 0; }.career-arrow { margin-left: auto; color: var(--accent); }
  .journey-link { display: flex; gap: 20px; min-height: 44px; align-items: center; font-size: .75rem; padding-left: 31px; }
  .focus-header { display: flex; justify-content: space-between; align-items: center; margin: 55px 0 15px; border-bottom: 1px solid var(--border-soft); padding-bottom: 10px; }
  .focus-header p { font-size: .75rem; color: var(--text-mute); letter-spacing: .08em; text-transform: uppercase; }.focus-header a { min-width: 44px; min-height: 44px; display: grid; place-items: center; }
  .focus-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 30px; }
  .focus-index { font-size: .75rem; color: #7694be; }.focus-card h3 { font-size: .86rem; line-height: 1.5; font-weight: 500; margin: 15px 0 11px; }.focus-card p { font-size: .86rem; color: var(--text-dim); margin: 0; }
  .writing-section { padding-bottom: 88px; }
  .writing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 24px; }
  .writing-card { color: inherit; background: var(--bg-soft); border-radius: 10px; overflow: hidden; border: 1px solid var(--border-soft); }.writing-card:hover { border-color: #596c88; color: inherit; }
  .writing-image { aspect-ratio: 16 / 9; overflow: hidden; }.writing-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s; }.writing-card:hover img { transform: scale(1.035); }
  .writing-copy { padding: 22px; position: relative; }.writing-date { color: var(--text-mute); font-size: .75rem; }.writing-copy h3 { font-size: .92rem; font-weight: 500; line-height: 1.6; margin: 13px 0 24px; }.writing-arrow { position: absolute; right: 22px; bottom: 18px; color: var(--accent); }
  .contact-section { background: #1a202a; padding: 70px 0; border-top: 1px solid #343f51; }
  .contact-layout { display: grid; grid-template-columns: 1.4fr 1fr; gap: 90px; align-items: center; }.contact-layout h2 { max-width: 17ch; }.contact-layout .eyebrow { color: #adc7ef; }.contact-summary { max-width: 43ch; font-size: .85rem; color: #b8c3d3; margin: 25px 0; }
  .contact-aside { border-left: 1px solid #3b4658; padding-left: 50px; }.contact-aside img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 1px solid #64758f; }.contact-aside p { font-size: 1.1rem; margin: 17px 0 4px; }.contact-aside > a { font-size: .78rem; }.contact-aside div { display: flex; gap: 25px; margin-top: 20px; }.contact-aside div a { display: flex; align-items: center; min-height: 44px; font-size: .72rem; color: #c4d3e9; }
  @media (max-width: 1000px) { .hero-layout { grid-template-columns: 1.1fr 1fr; min-height: 540px; }.experience-layout { gap: 50px; }.focus-grid { gap: 20px; }.work-featured .work-copy { padding: 30px; }.hero-topline { font-size: .75rem; }.contact-layout { gap: 45px; } }
  @media (max-width: 760px) { .hero-layout { grid-template-columns: 1fr; padding-top: 45px; gap: 5px; }.hero-copy { max-width: 580px; }h1 { font-size: clamp(2.9rem, 8vw, 4.5rem); }.hero-art { max-width: 510px; width: 100%; margin-inline: auto; }.edition { display: none; }.hero-summary { max-width: 48ch; }.work-section, .experience-preview, .writing-section { padding-top: 60px; }.section-heading { align-items: start; flex-direction: column; gap: 20px; }.section-heading h2 { max-width: 21ch; }.work-featured { display: block; }.work-grid { grid-template-columns: 1fr; }.work-featured .work-visual-link :global(.system-art) { min-height: 350px; }.work-featured .work-visual-link :global(.orbit-art) { height: 310px; }.experience-layout { grid-template-columns: 1fr; gap: 35px; }.experience-intro h2 { max-width: 20ch; }.focus-grid { grid-template-columns: 1fr 1fr; gap: 25px; }.writing-grid { grid-template-columns: 1fr; }.writing-card { display: grid; grid-template-columns: 140px 1fr; }.writing-image { height: 100%; aspect-ratio: auto; }.writing-copy { padding: 18px; }.contact-layout { grid-template-columns: 1fr; gap: 35px; }.contact-aside { padding-left: 0; padding-top: 30px; border-left: none; border-top: 1px solid #3b4658; }.contact-aside img { float: left; margin-right: 20px; }.contact-aside p { margin-top: 5px; } }
  @media (max-width: 420px) { .hero-role { font-size: .8rem; }h1 { font-size: 2.75rem; }.hero-summary { font-size: .92rem; }.hero-actions { gap: 16px; }.hero-baseline { gap: 15px; flex-wrap: wrap; }.hero-baseline > span { font-size: .68rem; }.hero-baseline a { font-size: .72rem; gap: 12px; }.work-copy, .work-featured .work-copy { padding: 24px; }.work-copy h3 { font-size: 1.65rem; }.writing-card { grid-template-columns: 1fr; }.writing-image { aspect-ratio: 16 / 9; }.focus-grid { gap: 20px; }.contact-section { padding: 50px 0; } }
</style>
