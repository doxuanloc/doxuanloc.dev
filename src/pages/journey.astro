---
import Base from '../layouts/Base.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import JourneyScene from '../components/JourneyScene.astro';
import { profile } from '../lib/content';
---
<Base title="Journey" description="Hành trình sự nghiệp của Đỗ Xuân Lộc — từ nền móng kỹ thuật tới AI Solutions Architect." animatedBg={false}>
  <JourneyScene />
  <section style="padding-bottom:24px">
    <div class="container">
      <p class="eyebrow" data-reveal>Scrollytelling</p>
      <h1 class="section-title" data-reveal style="--reveal-delay:60ms;font-size:clamp(1.8rem,5vw,2.6rem)">Hành trình</h1>
      <p class="section-sub" data-reveal style="--reveal-delay:100ms">
        Cuộn xuống để đi qua từng giai đoạn — {profile.identity.yearsExperience}+ năm từ frontend tới AI &amp; System Optimization.
        <span class="muted" style="display:block;margin-top:6px;font-size:.85rem">↓ Cuộn để khám phá</span>
      </p>
    </div>
  </section>

  <JourneyTimeline />

  <section style="padding-top:32px">
    <div class="container" style="text-align:center">
      <a class="btn btn-primary" href="/experience">Xem chi tiết kinh nghiệm →</a>
    </div>
  </section>
</Base>
