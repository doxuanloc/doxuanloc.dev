---
import Base from '../layouts/Base.astro';
import JourneyExplorer from '../components/journey/JourneyExplorer.astro';
import JourneyScene from '../components/JourneyScene.astro';
import { getProfile } from '../lib/content';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfile(lang);
---
<Base title={t('journey.title')} description={profile.summary} animatedBg={false}>
  <JourneyScene />
  <section style="padding-bottom:24px">
    <div class="container">
      <p class="eyebrow" data-reveal>{t('journey.eyebrow')}</p>
      <h1 class="section-title" data-reveal style="--reveal-delay:60ms;font-size:clamp(1.8rem,5vw,2.6rem)">{t('journey.title')}</h1>
      <p class="section-sub" data-reveal style="--reveal-delay:100ms">
        {t('journey.sub', { n: profile.identity.yearsExperience })}
        <span class="muted" style="display:block;margin-top:6px;font-size:.85rem">{t('journey.hint')}</span>
      </p>

    </div>
  </section>

  <!-- New spatial flight explorer: Story Chapters (default) + Timeline toggle.
       More seamless cards, chapter gates, live HUD, story filaments. -->
  <JourneyExplorer />

  <section style="padding-top:32px">
    <div class="container" style="text-align:center">
      <a class="btn btn-primary" href={localizedPath('/experience', lang)}>{t('journey.cta')}</a>
    </div>
  </section>
</Base>
