{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DailyContent",
  "type": "object",
  "required": [
    "date"
  ],
  "additionalProperties": true,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generatedBy": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "news": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "title",
          "summary",
          "source",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 600
          },
          "source": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 24
            }
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "blog": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "slug",
        "title",
        "excerpt",
        "contentMarkdown",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 4,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 8,
          "maxLength": 160
        },
        "excerpt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 320
        },
        "contentMarkdown": {
          "type": "string",
          "minLength": 200,
          "maxLength": 20000
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 24
          }
        },
        "readingTimeMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "coverImage": {
          "type": [
            "string",
            "null"
          ]
        },
        "interactiveBlock": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional raw HTML block for interactive visualizations \u2014 rendered after the lede. Must be self-contained (inline styles/scripts only). No external CDN deps."
        },
        "coverKeywords": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "linkedinPost": {
          "type": ["string", "null"],
          "maxLength": 1200,
          "description": "Pre-crafted LinkedIn post text. Hook + 3 insight bullets + link + hashtags. Vietnamese. ~600-900 chars."
        }
      }
    },
    "financeNews": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "title",
          "summary",
          "source",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 600
          },
          "source": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 24
            }
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "category": {
            "type": "string",
            "enum": [
              "fintech",
              "crypto",
              "vc-startup",
              "market",
              "macro"
            ]
          }
        }
      }
    },
    "expUpdate": {
      "$comment": "Skill snapshot \u2014 CH\u1ec8 th\u1ec3 hi\u1ec7n k\u1ef9 n\u0103ng/technique t\u1ef1 l\u00e0m \u0111\u01b0\u1ee3c, KH\u00d4NG m\u00f4 t\u1ea3 c\u00f4ng vi\u1ec7c th\u1eadt c\u1ee7a c\u00f4ng ty, KH\u00d4NG t\u00ean d\u1ef1 \u00e1n/kh\u00e1ch/s\u1ed1 li\u1ec7u n\u1ed9i b\u1ed9.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 600
        },
        "skills": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 48
          }
        },
        "highlights": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}