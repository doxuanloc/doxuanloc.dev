{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DailyContent",
  "type": "object",
  "required": ["date"],
  "additionalProperties": true,
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generatedBy": { "type": "string" },
    "version": { "type": "integer" },
    "news": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["title", "summary", "source", "tags"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 8, "maxLength": 160 },
          "summary": { "type": "string", "minLength": 20, "maxLength": 600 },
          "source": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "tags": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "maxLength": 24 } },
          "importance": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "blog": {
      "type": ["object", "null"],
      "required": ["slug", "title", "excerpt", "contentMarkdown", "tags"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 4, "maxLength": 120 },
        "title": { "type": "string", "minLength": 8, "maxLength": 160 },
        "excerpt": { "type": "string", "minLength": 20, "maxLength": 320 },
        "contentMarkdown": { "type": "string", "minLength": 200, "maxLength": 20000 },
        "tags": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 24 } },
        "readingTimeMin": { "type": "integer", "minimum": 1, "maximum": 60 },
        "coverImage": { "type": ["string", "null"] }
      }
    },
    "expUpdate": {
      "$comment": "Skill snapshot — CHỈ thể hiện kỹ năng/technique tự làm được, KHÔNG mô tả công việc thật của công ty, KHÔNG tên dự án/khách/số liệu nội bộ.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "maxLength": 600 },
        "skills": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 48 } },
        "highlights": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 200 } }
      }
    }
  }
}
